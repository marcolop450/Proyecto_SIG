<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VisorDatosSIG.Mobile.Views.ConsultaPage"
             Title="Consulta Temática"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="15">
            
            <!-- Título y Botones Superiores -->
            <Label Text="Consulta Temática de Inmuebles" FontSize="20" FontAttributes="Bold" TextColor="#333" />
            
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0" Text="Limpiar" BackgroundColor="#E0E0E0" TextColor="#333" CornerRadius="5" HeightRequest="40" />
                <Button Grid.Column="1" Text="Exportar CSV" BackgroundColor="#E0E0E0" TextColor="#333" CornerRadius="5" HeightRequest="40" />
            </Grid>
            
            <!-- Criterios de Filtrado -->
            <Frame BackgroundColor="White" CornerRadius="8" Padding="15" HasShadow="True" BorderColor="Transparent">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="CRITERIOS DE FILTRADO" FontAttributes="Bold" TextColor="#555" FontSize="14" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Total filtrados: 0 predios" FontSize="12" TextColor="Gray" VerticalOptions="Center"/>
                    </Grid>
                    
                    <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,5"/>

                    <!-- Código Fijo / Titular -->
                    <Label Text="Código Fijo o Titular" FontSize="12" TextColor="Gray" FontAttributes="Bold"/>
                    <Frame BorderColor="#DDDDDD" BackgroundColor="#FAFAFA" Padding="10,0" CornerRadius="5" HasShadow="False" HeightRequest="45">
                        <Entry Placeholder="Escriba código o nombre..." TextColor="#333" PlaceholderColor="#AAA" VerticalOptions="Center"/>
                    </Frame>

                    <!-- UV y Manzana (MZA) en la misma fila para ahorrar espacio -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="Unidad Vecinal (UV)" FontSize="12" TextColor="Gray" FontAttributes="Bold"/>
                            <Frame BorderColor="#DDDDDD" BackgroundColor="#FAFAFA" Padding="5,0" CornerRadius="5" HasShadow="False" HeightRequest="45">
                                <Picker Title="[ Todas las UVs ]" TextColor="#333" VerticalOptions="Center" TitleColor="#AAA"/>
                            </Frame>
                        </VerticalStackLayout>
                        
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Manzana (MZA)" FontSize="12" TextColor="Gray" FontAttributes="Bold"/>
                            <Frame BorderColor="#DDDDDD" BackgroundColor="#FAFAFA" Padding="5,0" CornerRadius="5" HasShadow="False" HeightRequest="45">
                                <Picker Title="[ Todas las MZA ]" TextColor="#333" VerticalOptions="Center" TitleColor="#AAA"/>
                            </Frame>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Lote -->
                    <Label Text="Lote" FontSize="12" TextColor="Gray" FontAttributes="Bold"/>
                    <Frame BorderColor="#DDDDDD" BackgroundColor="#FAFAFA" Padding="5,0" CornerRadius="5" HasShadow="False" HeightRequest="45">
                        <Picker Title="Todos los lotes" TextColor="#333" VerticalOptions="Center" TitleColor="#AAA"/>
                    </Frame>
                    
                    <Button Text="Buscar Predios" BackgroundColor="#C6A664" TextColor="#111" FontAttributes="Bold" CornerRadius="5" HeightRequest="45" Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Lista de Resultados (Adaptación Móvil de la Tabla) -->
            <Label Text="RESULTADOS" FontAttributes="Bold" TextColor="#555" FontSize="14" Margin="0,10,0,0"/>

            <!-- Estado Vacío -->
            <Frame BackgroundColor="White" CornerRadius="8" Padding="30" HasShadow="True" BorderColor="Transparent" MinimumHeightRequest="200">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="15">
                    <Image Source="dotnet_bot.png" WidthRequest="60" HeightRequest="60" Opacity="0.3" HorizontalOptions="Center"/>
                    <Label Text="No se encontraron predios con los criterios seleccionados." FontSize="14" TextColor="Gray" HorizontalTextAlignment="Center"/>
                    <Label Text="0 registros encontrados" FontSize="12" TextColor="LightGray" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Frame>
            
            <!-- Aquí iría un CollectionView en el futuro para mostrar las "Cards" de cada predio -->

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
