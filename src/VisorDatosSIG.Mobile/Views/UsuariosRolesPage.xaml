<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VisorDatosSIG.Mobile.Views.UsuariosRolesPage"
             Title="Usuarios y Roles"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="15">
            <!-- Header -->
            <Label Text="Control de Acceso y Perfiles" FontSize="20" FontAttributes="Bold" TextColor="#333" />
            <Label Text="Matriz de usuarios registrados y catálogo oficial de roles de seguridad" FontSize="13" TextColor="Gray" Margin="0,-15,0,0" />

            <!-- Cuentas de Usuario Activas -->
            <Frame BackgroundColor="White" CornerRadius="8" Padding="15" HasShadow="True" BorderColor="Transparent">
                <VerticalStackLayout Spacing="15">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Cuentas de Usuario Activas" FontAttributes="Bold" TextColor="#333" FontSize="15" VerticalOptions="Center"/>
                        <Frame Grid.Column="1" BackgroundColor="#5A834B" Padding="5,2" CornerRadius="3" HasShadow="False" BorderColor="Transparent">
                            <Label Text="PBKDF2 SHA-256" TextColor="White" FontSize="10" FontAttributes="Bold" />
                        </Frame>
                    </Grid>
                    
                    <BoxView HeightRequest="1" Color="#EEEEEE" />

                    <!-- User 1 -->
                    <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="15" RowSpacing="2">
                        <Label Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Text="1" FontSize="16" TextColor="#999" VerticalOptions="Center" />
                        <Label Grid.Row="0" Grid.Column="1" Text="Administrador" FontAttributes="Bold" TextColor="#333" />
                        <Label Grid.Row="1" Grid.Column="1" Text="admin" TextColor="#C9557C" FontSize="12" />
                        <VerticalStackLayout Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Spacing="5" VerticalOptions="Center" HorizontalOptions="End">
                            <Frame BackgroundColor="#333" Padding="8,2" CornerRadius="3" HasShadow="False" HorizontalOptions="End" BorderColor="Transparent">
                                <Label Text="Administrador" TextColor="White" FontSize="10" />
                            </Frame>
                            <Frame BackgroundColor="#27AE60" Padding="8,2" CornerRadius="3" HasShadow="False" HorizontalOptions="End" BorderColor="Transparent">
                                <Label Text="Activo" TextColor="White" FontSize="10" FontAttributes="Bold"/>
                            </Frame>
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F5F5F5" />
                    
                    <!-- User 2 -->
                    <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="15" RowSpacing="2">
                        <Label Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Text="2" FontSize="16" TextColor="#999" VerticalOptions="Center" />
                        <Label Grid.Row="0" Grid.Column="1" Text="Juan" FontAttributes="Bold" TextColor="#333" />
                        <Label Grid.Row="1" Grid.Column="1" Text="juan" TextColor="#C9557C" FontSize="12" />
                        <VerticalStackLayout Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Spacing="5" VerticalOptions="Center" HorizontalOptions="End">
                            <Frame BackgroundColor="#7F8C8D" Padding="8,2" CornerRadius="3" HasShadow="False" HorizontalOptions="End" BorderColor="Transparent">
                                <Label Text="Lecturador" TextColor="White" FontSize="10" />
                            </Frame>
                            <Frame BackgroundColor="#27AE60" Padding="8,2" CornerRadius="3" HasShadow="False" HorizontalOptions="End" BorderColor="Transparent">
                                <Label Text="Activo" TextColor="White" FontSize="10" FontAttributes="Bold"/>
                            </Frame>
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F5F5F5" />
                    
                    <!-- User 3 -->
                    <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="15" RowSpacing="2">
                        <Label Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Text="3" FontSize="16" TextColor="#999" VerticalOptions="Center" />
                        <Label Grid.Row="0" Grid.Column="1" Text="Pedro" FontAttributes="Bold" TextColor="#333" />
                        <Label Grid.Row="1" Grid.Column="1" Text="pedro" TextColor="#C9557C" FontSize="12" />
                        <VerticalStackLayout Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Spacing="5" VerticalOptions="Center" HorizontalOptions="End">
                            <Frame BackgroundColor="#C0392B" Padding="8,2" CornerRadius="3" HasShadow="False" HorizontalOptions="End" BorderColor="Transparent">
                                <Label Text="Cortador" TextColor="White" FontSize="10" />
                            </Frame>
                            <Frame BackgroundColor="#27AE60" Padding="8,2" CornerRadius="3" HasShadow="False" HorizontalOptions="End" BorderColor="Transparent">
                                <Label Text="Activo" TextColor="White" FontSize="10" FontAttributes="Bold"/>
                            </Frame>
                        </VerticalStackLayout>
                    </Grid>
                    
                </VerticalStackLayout>
            </Frame>

            <!-- Catálogo de Roles del Sistema -->
            <Frame BackgroundColor="White" CornerRadius="8" Padding="15" HasShadow="True" BorderColor="Transparent">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Catálogo de Roles del Sistema (5 Roles)" FontAttributes="Bold" TextColor="#333" FontSize="15" />
                    <BoxView HeightRequest="1" Color="#EEEEEE" />

                    <!-- Role 1 -->
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
                        <Label Grid.Row="0" Grid.Column="0" Text="Administrador" FontAttributes="Bold" TextColor="#333" />
                        <Label Grid.Row="1" Grid.Column="0" Text="Administrador del Sistema" TextColor="Gray" FontSize="12" />
                        <Frame Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" BackgroundColor="#E0E0E0" Padding="8,4" CornerRadius="3" HasShadow="False" VerticalOptions="Center" BorderColor="Transparent">
                            <Label Text="ID: 1" TextColor="#555" FontSize="10" FontAttributes="Bold"/>
                        </Frame>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F5F5F5" />

                    <!-- Role 2 -->
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
                        <Label Grid.Row="0" Grid.Column="0" Text="Catastro" FontAttributes="Bold" TextColor="#333" />
                        <Label Grid.Row="1" Grid.Column="0" Text="Rol para crear, modificar y eliminar Manzanas, Lotes, Codigo Fijo y Vias" TextColor="Gray" FontSize="12" LineBreakMode="WordWrap" />
                        <Frame Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" BackgroundColor="#E0E0E0" Padding="8,4" CornerRadius="3" HasShadow="False" VerticalOptions="Center" BorderColor="Transparent">
                            <Label Text="ID: 2" TextColor="#555" FontSize="10" FontAttributes="Bold"/>
                        </Frame>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F5F5F5" />

                    <!-- Role 3 -->
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
                        <Label Grid.Row="0" Grid.Column="0" Text="Lecturador" FontAttributes="Bold" TextColor="#333" />
                        <Label Grid.Row="1" Grid.Column="0" Text="Rol para lecturar medidores" TextColor="Gray" FontSize="12" />
                        <Frame Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" BackgroundColor="#E0E0E0" Padding="8,4" CornerRadius="3" HasShadow="False" VerticalOptions="Center" BorderColor="Transparent">
                            <Label Text="ID: 3" TextColor="#555" FontSize="10" FontAttributes="Bold"/>
                        </Frame>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F5F5F5" />

                    <!-- Role 4 -->
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
                        <Label Grid.Row="0" Grid.Column="0" Text="Cortador" FontAttributes="Bold" TextColor="#333" />
                        <Label Grid.Row="1" Grid.Column="0" Text="Rol para cortar servicios" TextColor="Gray" FontSize="12" />
                        <Frame Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" BackgroundColor="#E0E0E0" Padding="8,4" CornerRadius="3" HasShadow="False" VerticalOptions="Center" BorderColor="Transparent">
                            <Label Text="ID: 4" TextColor="#555" FontSize="10" FontAttributes="Bold"/>
                        </Frame>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F5F5F5" />

                    <!-- Role 5 -->
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
                        <Label Grid.Row="0" Grid.Column="0" Text="Reconexion" FontAttributes="Bold" TextColor="#333" />
                        <Label Grid.Row="1" Grid.Column="0" Text="Rol para la reconnexion por corte" TextColor="Gray" FontSize="12" />
                        <Frame Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" BackgroundColor="#E0E0E0" Padding="8,4" CornerRadius="3" HasShadow="False" VerticalOptions="Center" BorderColor="Transparent">
                            <Label Text="ID: 5" TextColor="#555" FontSize="10" FontAttributes="Bold"/>
                        </Frame>
                    </Grid>

                </VerticalStackLayout>
            </Frame>
            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
