@model VisorDatosSIG.Application.DTOs.EstadisticasCapasDto
@{
    ViewData["Title"] = "Panel Principal";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2" style="border-bottom: 2px solid #E2DFD6;">
    <div>
        <h3 class="mb-1" style="font-weight: 700; color: #2C2D2A;">Panel Principal</h3>
        <p class="text-muted mb-0" style="font-size: 0.9rem;">
            Resumen de capas espaciales migradas y estado de la base de datos SQL Server 2022
        </p>
    </div>
    <div>
        <a asp-controller="Mapa" asp-action="Index" class="btn btn-olive">
            <span>🗺</span> Abrir Visor Cartográfico
        </a>
    </div>
</div>

<!-- Tarjetas Métricas de las 4 Capas -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-value">@Model.TotalManzanas.ToString("N0")</div>
            <div class="stat-label">Manzanas</div>
            <div class="text-muted small mt-2">Delimitaciones Urbanas (Polígonos)</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card card-amber">
            <div class="stat-value">@Model.TotalLotes.ToString("N0")</div>
            <div class="stat-label">Lotes Catastrales</div>
            <div class="text-muted small mt-2">Parcelas Urbanas (Polígonos)</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card card-terracota">
            <div class="stat-value">@Model.TotalCodigosFijos.ToString("N0")</div>
            <div class="stat-label">Códigos Fijos</div>
            <div class="text-muted small mt-2">Ubicaciones Medidores (Puntos)</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card card-dark">
            <div class="stat-value">@Model.TotalVias.ToString("N0")</div>
            <div class="stat-label">Red Vial</div>
            <div class="text-muted small mt-2">Ejes y Calles (Líneas)</div>
        </div>
    </div>
</div>

<!-- Accesos Rápidos y Estado del Sistema -->
<div class="row g-4">
    <div class="col-md-7">
        <div class="card shadow-sm" style="border: 1px solid #E2DFD6; background: #FFFFFF;">
            <div class="card-header py-3" style="background: #FAF9F5; border-bottom: 1px solid #E2DFD6;">
                <h5 class="card-title m-0" style="font-size: 1.05rem; font-weight: 600; color: #383B34;">Operaciones Rápidas</h5>
            </div>
            <div class="card-body p-4">
                <p class="text-muted" style="font-size: 0.9rem;">
                    Seleccione una acción para iniciar la consulta cartográfica o la búsqueda alfanumérica de predios:
                </p>
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <a asp-controller="Mapa" asp-action="Index" class="btn btn-olive px-4 py-2">
                        Explorar Mapa y Capas
                    </a>
                    <a asp-controller="Consultas" asp-action="Index" class="btn btn-sand px-4 py-2">
                        Búsqueda de Códigos Fijos
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card shadow-sm" style="border: 1px solid #E2DFD6; background: #FFFFFF;">
            <div class="card-header py-3" style="background: #FAF9F5; border-bottom: 1px solid #E2DFD6;">
                <h5 class="card-title m-0" style="font-size: 1.05rem; font-weight: 600; color: #383B34;">Estado de Infraestructura</h5>
            </div>
            <div class="card-body p-3">
                <ul class="list-unstyled mb-0" style="font-size: 0.88rem;">
                    <li class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Motor Espacial:</span>
                        <strong class="text-success">Microsoft SQL Server 2022 (Local)</strong>
                    </li>
                    <li class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Base de Datos:</span>
                        <strong>VisorDatosSIG</strong>
                    </li>
                    <li class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Sistema de Coordenadas:</span>
                        <strong>WGS 84 (SRID 4326)</strong>
                    </li>
                    <li class="d-flex justify-content-between py-2">
                        <span class="text-muted">Servicios GeoJSON:</span>
                        <span class="badge bg-success">Activos y Operativos</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
