@using System.Security.Claims
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>@ViewData["Title"] - VisorDatosSIG</title>
    
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="shortcut icon" href="~/favicon.svg" />
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#2E4636" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="VisorDatosSIG" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
        var isMapa = currentController == "Mapa";

        <!-- Barra Superior Horizontal Oficial (Top Navbar) -->
        <header class="navbar-sig">
            <div class="d-flex align-items-center gap-2 gap-md-3">
                <!-- Botón Menú Hamburguesa para Móviles (< 768px) -->
                <button class="btn btn-sm d-md-none text-white border-0 p-1 me-1" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavSig" aria-controls="offcanvasNavSig" aria-label="Abrir menú de navegación">
                    <i class="bi bi-list fs-2"></i>
                </button>

                <a class="navbar-brand-sig" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon-box">
                        <i class="bi bi-layers-half text-white" style="font-size: 1.3rem;"></i>
                    </div>
                    <div>
                        <div class="brand-title">VisorDatosSIG</div>
                        <div class="brand-subtitle">Sistema Catastral Municipal</div>
                    </div>
                </a>

                <nav class="d-none d-md-flex align-items-center gap-1 ms-3">
                    <a asp-controller="Home" asp-action="Index" class="nav-link-sig @(currentController == "Home" && currentAction == "Index" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i> Inicio
                    </a>
                    <a asp-controller="Mapa" asp-action="Index" class="nav-link-sig @(isMapa ? "active" : "")">
                        <i class="bi bi-map"></i> Visor Cartográfico
                    </a>
                    <a asp-controller="Consultas" asp-action="Index" class="nav-link-sig @(currentController == "Consultas" ? "active" : "")">
                        <i class="bi bi-search"></i> Consultas
                    </a>

                    @if (User.IsInRole("Administrador"))
                    {
                        <div class="dropdown">
                            <a class="nav-link-sig dropdown-toggle @(currentController == "Admin" ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-shield-lock"></i> Administración
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark shadow" style="background-color: #1F382B; border-color: rgba(200,157,60,0.3);">
                                <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Usuarios"><i class="bi bi-people me-2"></i> Usuarios</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Roles"><i class="bi bi-shield-lock me-2"></i> Perfiles y Permisos</a></li>
                                <li><hr class="dropdown-divider border-secondary"></li>
                                <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="CatalogoCapas"><i class="bi bi-layers me-2"></i> Catálogo de Capas</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="HistorialMigraciones"><i class="bi bi-clock-history me-2"></i> Historial Migraciones</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Bitacora"><i class="bi bi-journal-text me-2"></i> Bitácora del Sistema</a></li>
                            </ul>
                        </div>
                    }

                    <a asp-controller="Account" asp-action="Perfil" class="nav-link-sig @(currentController == "Account" && currentAction == "Perfil" ? "active" : "")">
                        <i class="bi bi-person-badge"></i> Mi Perfil
                    </a>

                    <div class="dropdown">
                        <a class="nav-link-sig dropdown-toggle @(currentController == "Home" && (currentAction == "Manual" || currentAction == "AcercaDe") ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-question-circle"></i> Ayuda
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark shadow" style="background-color: #1F382B; border-color: rgba(200,157,60,0.3);">
                            <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="Manual"><i class="bi bi-book me-2"></i> Manual de Usuario</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="AcercaDe"><i class="bi bi-info-circle me-2"></i> Acerca del Sistema</a></li>
                        </ul>
                    </div>
                </nav>
            </div>

            <div class="d-flex align-items-center gap-2 gap-md-3">
                <div class="d-none d-sm-flex align-items-center gap-2">
                    <i class="bi bi-person-circle text-white-50" style="font-size: 1.1rem;"></i>
                    <span class="text-white small fw-bold">@(User.FindFirst("NombreCompleto")?.Value ?? User.Identity?.Name)</span>
                    <span class="badge-role">
                        @string.Join(", ", User.FindAll(ClaimTypes.Role).Select(c => c.Value))
                    </span>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-salir-sig d-flex align-items-center gap-1" title="Cerrar sesión">
                        <i class="bi bi-box-arrow-right"></i>
                        <span class="d-none d-sm-inline">Salir</span>
                    </button>
                </form>
            </div>
        </header>

        <!-- Drawer de Navegación Móvil Offcanvas (< 768px) -->
        <div class="offcanvas offcanvas-start text-white shadow" tabindex="-1" id="offcanvasNavSig" aria-labelledby="offcanvasNavSigLabel" style="background-color: #24382B; width: 290px;">
            <div class="offcanvas-header border-bottom" style="border-color: rgba(200,157,60,0.3) !important;">
                <div class="d-flex align-items-center gap-2">
                    <div class="brand-icon-box" style="width: 32px; height: 32px;">
                        <i class="bi bi-layers-half text-white" style="font-size: 1.1rem;"></i>
                    </div>
                    <div>
                        <h5 class="offcanvas-title fw-bold fs-6 m-0 text-white" id="offcanvasNavSigLabel">VisorDatosSIG</h5>
                        <small class="text-white-50" style="font-size: 0.72rem;">San Ignacio de Velasco</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
            </div>
            <div class="offcanvas-body p-3 d-flex flex-column justify-content-between">
                <div class="d-flex flex-column gap-1">
                    <div class="d-sm-none pb-2 mb-2 border-bottom border-secondary-subtle">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-person-circle text-white-50 fs-5"></i>
                            <div>
                                <div class="text-white small fw-bold">@(User.FindFirst("NombreCompleto")?.Value ?? User.Identity?.Name)</div>
                                <span class="badge-role" style="font-size: 0.68rem;">
                                    @string.Join(", ", User.FindAll(ClaimTypes.Role).Select(c => c.Value))
                                </span>
                            </div>
                        </div>
                    </div>

                    <a asp-controller="Home" asp-action="Index" class="nav-link-sig w-100 py-2 @(currentController == "Home" && currentAction == "Index" ? "active" : "")">
                        <i class="bi bi-speedometer2 me-2"></i> Inicio
                    </a>
                    <a asp-controller="Mapa" asp-action="Index" class="nav-link-sig w-100 py-2 @(isMapa ? "active" : "")">
                        <i class="bi bi-map me-2"></i> Visor Cartográfico
                    </a>
                    <a asp-controller="Consultas" asp-action="Index" class="nav-link-sig w-100 py-2 @(currentController == "Consultas" ? "active" : "")">
                        <i class="bi bi-search me-2"></i> Consultas
                    </a>

                    @if (User.IsInRole("Administrador"))
                    {
                        <div class="mt-2 pt-2 border-top border-secondary-subtle">
                            <span class="text-uppercase text-white-50 fw-bold px-2" style="font-size: 0.7rem; letter-spacing: 1px;">Administración</span>
                            <a class="nav-link-sig w-100 py-2 mt-1" asp-controller="Admin" asp-action="Usuarios"><i class="bi bi-people me-2"></i> Usuarios</a>
                            <a class="nav-link-sig w-100 py-2" asp-controller="Admin" asp-action="Roles"><i class="bi bi-shield-lock me-2"></i> Perfiles y Permisos</a>
                            <a class="nav-link-sig w-100 py-2" asp-controller="Admin" asp-action="CatalogoCapas"><i class="bi bi-layers me-2"></i> Catálogo de Capas</a>
                            <a class="nav-link-sig w-100 py-2" asp-controller="Admin" asp-action="HistorialMigraciones"><i class="bi bi-clock-history me-2"></i> Historial Migraciones</a>
                            <a class="nav-link-sig w-100 py-2" asp-controller="Admin" asp-action="Bitacora"><i class="bi bi-journal-text me-2"></i> Bitácora del Sistema</a>
                        </div>
                    }

                    <div class="mt-2 pt-2 border-top border-secondary-subtle">
                        <a asp-controller="Account" asp-action="Perfil" class="nav-link-sig w-100 py-2 @(currentController == "Account" && currentAction == "Perfil" ? "active" : "")">
                            <i class="bi bi-person-badge me-2"></i> Mi Perfil
                        </a>
                        <a asp-controller="Home" asp-action="Manual" class="nav-link-sig w-100 py-2 @(currentController == "Home" && currentAction == "Manual" ? "active" : "")">
                            <i class="bi bi-book me-2"></i> Manual de Usuario
                        </a>
                        <a asp-controller="Home" asp-action="AcercaDe" class="nav-link-sig w-100 py-2 @(currentController == "Home" && currentAction == "AcercaDe" ? "active" : "")">
                            <i class="bi bi-info-circle me-2"></i> Acerca del Sistema
                        </a>
                    </div>
                </div>

                <div class="pt-3 border-top border-secondary-subtle">
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger w-100 d-flex align-items-center justify-content-center gap-2 py-2">
                            <i class="bi bi-box-arrow-right"></i>
                            Cerrar Sesión
                        </button>
                    </form>
                </div>
            </div>
        </div>

        @if (isMapa)
        {
            <main class="map-full-viewport">
                @RenderBody()
            </main>
        }
        else
        {
            <main class="container-fluid py-4 px-4" style="max-width: 1440px;">
                @RenderBody()
            </main>
        }
    }
    else
    {
        <main>
            @RenderBody()
        </main>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js')
                    .then(reg => console.log('VisorDatosSIG PWA ServiceWorker registrado:', reg.scope))
                    .catch(err => console.log('ServiceWorker no disponible:', err));
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
