@using System.Security.Claims
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VisorDatosSIG</title>
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <!-- Custom Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <header class="app-header">
            <a class="app-brand" asp-controller="Home" asp-action="Index">
                <span>FICCT ·</span> VisorDatosSIG <span>2026</span>
            </a>
            <div class="d-flex align-items-center gap-3">
                <span class="badge" style="background-color: #4A4D46; color: #E8E5DC; font-weight: normal; padding: 0.4rem 0.75rem;">
                    Usuario: <strong>@(User.FindFirst("NombreCompleto")?.Value ?? User.Identity.Name)</strong>
                    <small class="text-warning ms-1">(@string.Join(", ", User.FindAll(ClaimTypes.Role).Select(c => c.Value)))</small>
                </span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-sand py-1 px-3">Cerrar Sesión</button>
                </form>
            </div>
        </header>

        <div class="app-layout">
            <aside class="app-sidebar">
                <div class="sidebar-heading">Navegación Principal</div>
                <ul class="sidebar-menu">
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                        <a asp-controller="Home" asp-action="Index">
                            <span>▦</span> Panel Principal
                        </a>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Mapa" ? "active" : "")">
                        <a asp-controller="Mapa" asp-action="Index">
                            <span>🗺</span> Visor Cartográfico
                        </a>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Consultas" ? "active" : "")">
                        <a asp-controller="Consultas" asp-action="Index">
                            <span>🔍</span> Consulta Temática
                        </a>
                    </li>
                </ul>

                @if (User.IsInRole("Administrador"))
                {
                    <div class="sidebar-heading mt-3">Administración</div>
                    <ul class="sidebar-menu">
                        <li><a href="javascript:void(0)" onclick="alert('Módulo disponible para el Administrador.')"><span>⚙</span> Configuración</a></li>
                        <li><a href="javascript:void(0)" onclick="alert('Historial de cargas registrado en bitacora_migracion.txt')"><span>📋</span> Bitácora</a></li>
                    </ul>
                }

                <div class="mt-auto p-3 text-muted" style="font-size: 0.75rem; border-top: 1px solid #383B35;">
                    <div>Gestión SIG 2026</div>
                    <div>UAGRM - FICCT</div>
                </div>
            </aside>

            <main class="app-content">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main>
            @RenderBody()
        </main>
    }

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
