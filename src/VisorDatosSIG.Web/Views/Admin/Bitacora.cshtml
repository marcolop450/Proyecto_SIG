@model string
@{
    ViewData["Title"] = "Bitácora de Operaciones";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h4 class="mb-1" style="font-weight: 700; color: #2C2D2A;">Bitácora de Carga y Migración</h4>
        <p class="text-muted mb-0" style="font-size: 0.88rem;">
            Historial de procesos de ingesta, auditoría de geometrías y relaciones espaciales
        </p>
    </div>
    <div>
        <a asp-action="Bitacora" class="btn btn-sand btn-sm">Actualizar Registro</a>
    </div>
</div>

<div class="card shadow-sm" style="background: #FFFFFF; border: 1px solid #E2DFD6;">
    <div class="card-header py-2 px-3 d-flex justify-content-between align-items-center" style="background: #FAF9F5; border-bottom: 1px solid #E2DFD6;">
        <span class="small text-muted font-monospace">Archivo: @ViewBag.LogPath</span>
        <span class="badge" style="background-color: #5E7A4A;">Auditoría Activa</span>
    </div>
    <div class="card-body p-0">
        <pre class="m-0 p-3" style="background: #2B2D29; color: #E5E2D8; font-family: Consolas, monospace; font-size: 0.84rem; max-height: 520px; overflow-y: auto; white-space: pre-wrap;">@Model</pre>
    </div>
</div>
