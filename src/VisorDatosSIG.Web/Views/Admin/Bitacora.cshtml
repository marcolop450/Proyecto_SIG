@model IEnumerable<VisorDatosSIG.Web.Controllers.LogEntryDto>
@{
    ViewData["Title"] = "Bitácora de Auditoría";
    int totalEventos = ViewBag.TotalEventos ?? 0;
    int totalExitos = ViewBag.TotalExitos ?? 0;
    int totalAdvertencias = ViewBag.TotalAdvertencias ?? 0;
}

<!-- Encabezado Institucional -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3" style="border-bottom: 2px solid #E2DFD6;">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <div class="brand-icon-box" style="width: 32px; height: 32px; border-radius: 6px;">
                <i class="bi bi-journal-text text-white" style="font-size: 1.15rem;"></i>
            </div>
            <h4 class="mb-0 fw-bold" style="color: #2C2D2A;">
                Bitácora de Auditoría y Migración
            </h4>
            <span class="badge" style="background-color: #EDE9DF; color: #4B4E47; border: 1px solid #D5D1C6; font-size: 0.75rem;">
                Trazabilidad Transaccional
            </span>
        </div>
        <p class="text-muted mb-0" style="font-size: 0.88rem;">
            Registro cronológico detallado de eventos de ingesta espacial, transacciones en base de datos y validaciones OGC.
        </p>
    </div>
    <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
        <a asp-action="Bitacora" class="btn btn-sand btn-sm d-flex align-items-center gap-1 shadow-sm">
            <i class="bi bi-arrow-clockwise"></i>
            <span>Actualizar</span>
        </a>
        <button onclick="copiarBitacora()" class="btn btn-sig-chiquitano btn-sm d-flex align-items-center gap-1 shadow-sm">
            <i class="bi bi-clipboard-check"></i>
            <span>Copiar Log</span>
        </button>
    </div>
</div>

<!-- Tarjetas KPI de Auditoría sin Antipatrones -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card shadow-sm border-0 stat-card-impeccable" style="background: #FFFFFF;">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-start mb-1">
                    <span class="text-uppercase text-muted fw-bold small" style="font-size: 0.72rem;">Eventos Totales</span>
                    <i class="bi bi-activity text-muted"></i>
                </div>
                <div class="fs-2 fw-bold text-dark my-1">@totalEventos</div>
                <span class="badge" style="background-color: #F1F5F9; color: #475569; font-size: 0.72rem;">Registros de Log</span>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card shadow-sm border-0 stat-card-impeccable" style="background: #FFFFFF;">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-start mb-1">
                    <span class="text-uppercase text-muted fw-bold small" style="font-size: 0.72rem;">Operaciones Exitosas</span>
                    <i class="bi bi-check2-circle text-success"></i>
                </div>
                <div class="fs-2 fw-bold text-success my-1">@totalExitos</div>
                <span class="badge" style="background-color: #D1FAE5; color: #065F46; font-size: 0.72rem;">Sin Errores OGC</span>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card shadow-sm border-0 stat-card-impeccable" style="background: #FFFFFF;">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-start mb-1">
                    <span class="text-uppercase text-muted fw-bold small" style="font-size: 0.72rem;">Advertencias</span>
                    <i class="bi bi-exclamation-triangle text-warning"></i>
                </div>
                <div class="fs-2 fw-bold my-1" style="color: #78350F;">@totalAdvertencias</div>
                <span class="badge" style="background-color: #FEF3C7; color: #78350F; font-size: 0.72rem;">Validaciones Geometría</span>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card shadow-sm border-0 stat-card-impeccable" style="background: #FFFFFF;">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-start mb-1">
                    <span class="text-uppercase text-muted fw-bold small" style="font-size: 0.72rem;">Tiempo de Carga</span>
                    <i class="bi bi-clock-history text-muted"></i>
                </div>
                <div class="fs-2 fw-bold text-dark my-1">@(ViewBag.Duracion ?? "192.5 s")</div>
                <span class="badge" style="background-color: #E0E7FF; color: #3730A3; font-size: 0.72rem;">SQL Server Bulk</span>
            </div>
        </div>
    </div>
</div>

<!-- Filtros y Tabla de Auditoría -->
<div class="card shadow-sm border-0 mb-4" style="background: #FFFFFF; border: 1px solid #E2DFD6 !important; border-radius: 8px;">
    <div class="card-header py-3 px-3 px-md-4 d-flex flex-wrap justify-content-between align-items-center gap-2" style="background: #FAF9F5; border-bottom: 1px solid #E2DFD6;">
        <div class="d-flex align-items-center gap-2">
            <h6 class="m-0 fw-bold" style="color: #2C2D2A;">Registro de Operaciones</h6>
            <span class="badge" style="background-color: #2E4636; color: #FFFFFF;" id="lblContadorFiltrado">@Model.Count() Registros</span>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <div class="input-group input-group-sm" style="max-width: 240px;">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" id="filtroLog" class="form-control border-start-0" placeholder="Filtrar eventos..." onkeyup="filtrarTablaLog()" />
            </div>
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn btn-outline-secondary active" onclick="filtrarTipo('TODOS', this)">Todos</button>
                <button type="button" class="btn btn-outline-success" onclick="filtrarTipo('EXITO', this)">Éxitos</button>
                <button type="button" class="btn btn-outline-warning" onclick="filtrarTipo('ADVERTENCIA', this)">Advertencias</button>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle m-0" id="tablaLog" style="font-size: 0.88rem;">
            <thead style="background: #FAF9F5; border-bottom: 2px solid #E2DFD6;">
                <tr>
                    <th class="ps-3" style="width: 110px;">Hora</th>
                    <th style="width: 140px;">Nivel</th>
                    <th style="width: 180px;">Módulo / Capa</th>
                    <th>Mensaje y Detalle de Ingesta</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model)
                {
                    <tr class="log-row" data-tipo="@entry.Tipo">
                        <td class="ps-3 font-monospace text-muted small">@entry.Timestamp</td>
                        <td>
                            @if (entry.Tipo == "EXITO")
                            {
                                <span class="badge d-inline-flex align-items-center gap-1 fw-bold" style="background-color: #D1FAE5; color: #065F46; border: 1px solid #A7F3D0; font-size: 0.74rem;">
                                    <i class="bi bi-check-circle"></i> Éxito
                                </span>
                            }
                            else if (entry.Tipo == "ADVERTENCIA")
                            {
                                <span class="badge d-inline-flex align-items-center gap-1 fw-bold" style="background-color: #FEF3C7; color: #78350F; border: 1px solid #FDE68A; font-size: 0.74rem;">
                                    <i class="bi bi-exclamation-triangle"></i> Advertencia
                                </span>
                            }
                            else
                            {
                                <span class="badge d-inline-flex align-items-center gap-1 fw-bold" style="background-color: #F1F5F9; color: #475569; border: 1px solid #E2E8F0; font-size: 0.74rem;">
                                    <i class="bi bi-info-circle"></i> Info
                                </span>
                            }
                        </td>
                        <td>
                            <strong style="color: #2E4636; font-size: 0.85rem;">@entry.Modulo</strong>
                        </td>
                        <td style="color: #2C2D2A;">
                            @entry.Mensaje
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Registro Técnico en Bruto (Colapsable para Inspección) -->
<div class="card shadow-sm border-0 mb-4" style="background: #FFFFFF; border: 1px solid #E2DFD6 !important; border-radius: 8px;">
    <div class="card-header py-2 px-3 d-flex justify-content-between align-items-center" style="background: #FAF9F5; cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#collapseRawLog">
        <span class="small fw-bold text-muted d-flex align-items-center gap-2">
            <i class="bi bi-file-earmark-code"></i>
            Archivo Fuente: <code>@ViewBag.LogPath</code>
        </span>
        <span class="btn btn-sm btn-link p-0 text-decoration-none text-muted">
            <i class="bi bi-chevron-down"></i> Ver Texto en Bruto
        </span>
    </div>
    <div class="collapse" id="collapseRawLog">
        <div class="card-body p-0">
            <textarea id="txtRawLog" class="form-control font-monospace m-0 border-0 p-3" rows="8" readonly style="background: #242622; color: #E5E2D8; font-size: 0.82rem; resize: vertical;">@ViewBag.RawLog</textarea>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let filtroActivo = 'TODOS';

    function filtrarTablaLog() {
        let texto = document.getElementById('filtroLog').value.toLowerCase().trim();
        let rows = document.querySelectorAll('.log-row');
        let visibles = 0;

        rows.forEach(r => {
            let tipoMatch = (filtroActivo === 'TODOS' || r.getAttribute('data-tipo') === filtroActivo);
            let textoMatch = r.innerText.toLowerCase().includes(texto);

            if (tipoMatch && textoMatch) {
                r.style.display = '';
                visibles++;
            } else {
                r.style.display = 'none';
            }
        });

        document.getElementById('lblContadorFiltrado').innerText = `${visibles} Registros`;
    }

    function filtrarTipo(tipo, btn) {
        filtroActivo = tipo;
        btn.parentElement.querySelectorAll('.btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        filtrarTablaLog();
    }

    function copiarBitacora() {
        let raw = document.getElementById('txtRawLog').value;
        navigator.clipboard.writeText(raw).then(() => {
            alert('Registro de bitácora copiado al portapapeles.');
        });
    }
</script>
}
