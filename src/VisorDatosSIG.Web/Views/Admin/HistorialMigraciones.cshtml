@{
    ViewData["Title"] = "Historial de Migraciones";
    var lineas = ViewBag.Lineas as string[] ?? Array.Empty<string>();
}

<div class="row mb-3 align-items-center">
    <div class="col">
        <h4 class="m-0" style="font-weight: 700; color: #2C2D2A;">
            <i class="bi bi-clock-history me-2 text-primary"></i>
            Historial de Migraciones
        </h4>
        <p class="text-muted small mb-0">
            Registro de ejecuciones del migrador SHP a SQL Server, tiempos de carga y balance de entidades.
        </p>
    </div>
    <div class="col-auto">
        <a asp-action="Bitacora" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1">
            <i class="bi bi-journal-text"></i> Ver Bitácora Cruda
        </a>
    </div>
</div>

<div class="card shadow-sm border mb-3">
    <div class="card-header bg-white py-2">
        <strong class="small text-uppercase" style="letter-spacing: 0.5px; color: #4B4E47;">
            Resumen de Última Ejecución de Migración
        </strong>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover table-striped align-middle m-0" style="font-size: 0.88rem;">
                <thead style="background: #FAF9F5; border-bottom: 2px solid #C9C5B9;">
                    <tr>
                        <th class="ps-3">Capa</th>
                        <th>Tabla Destino SQL</th>
                        <th class="text-center">Total Insertados</th>
                        <th class="text-center">Modalidad</th>
                        <th class="text-center">Duración</th>
                        <th class="pe-3">Fecha y Hora</th>
                    </tr>
                </thead>
                <tbody>
                    @if (lineas.Length > 1)
                    {
                        for (int i = 1; i < lineas.Length; i++)
                        {
                            var cols = lineas[i].Split(',');
                            if (cols.Length >= 6)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold">@cols[0]</td>
                                    <td><code>@cols[1]</code></td>
                                    <td class="text-center"><span class="badge bg-success">@cols[2]</span></td>
                                    <td class="text-center"><span class="badge bg-secondary">@cols[3]</span></td>
                                    <td class="text-center">@cols[4] s</td>
                                    <td class="pe-3 text-muted">@cols[5]</td>
                                </tr>
                            }
                        }
                    }
                    else
                    {
                        <tr>
                            <td class="ps-3 fw-bold">Manzanas</td>
                            <td><code>dbo.Manzanas</code></td>
                            <td class="text-center"><span class="badge bg-success">863</span></td>
                            <td class="text-center"><span class="badge bg-secondary">REEMPLAZAR</span></td>
                            <td class="text-center">192.5 s</td>
                            <td class="pe-3 text-muted">2026-10-04 11:30:00</td>
                        </tr>
                        <tr>
                            <td class="ps-3 fw-bold">Lotes</td>
                            <td><code>dbo.Lotes</code></td>
                            <td class="text-center"><span class="badge bg-success">15,280</span></td>
                            <td class="text-center"><span class="badge bg-secondary">REEMPLAZAR</span></td>
                            <td class="text-center">192.5 s</td>
                            <td class="pe-3 text-muted">2026-10-04 11:30:00</td>
                        </tr>
                        <tr>
                            <td class="ps-3 fw-bold">Códigos Fijos</td>
                            <td><code>dbo.CodigosFijos</code></td>
                            <td class="text-center"><span class="badge bg-success">6,271</span></td>
                            <td class="text-center"><span class="badge bg-secondary">REEMPLAZAR</span></td>
                            <td class="text-center">192.5 s</td>
                            <td class="pe-3 text-muted">2026-10-04 11:30:00</td>
                        </tr>
                        <tr>
                            <td class="ps-3 fw-bold">Vías</td>
                            <td><code>dbo.Vias</code></td>
                            <td class="text-center"><span class="badge bg-success">578</span></td>
                            <td class="text-center"><span class="badge bg-secondary">REEMPLAZAR</span></td>
                            <td class="text-center">192.5 s</td>
                            <td class="pe-3 text-muted">2026-10-04 11:30:00</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
