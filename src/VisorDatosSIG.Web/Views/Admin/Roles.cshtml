@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Perfiles y Permisos (RBAC)";
}

<!-- Encabezado Institucional -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3" style="border-bottom: 2px solid #E2DFD6;">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <div class="brand-icon-box" style="width: 32px; height: 32px; border-radius: 6px;">
                <i class="bi bi-shield-lock-fill text-white" style="font-size: 1.15rem;"></i>
            </div>
            <h4 class="mb-0 fw-bold" style="color: #2C2D2A;">
                Perfiles y Permisos de Acceso (RBAC)
            </h4>
            <span class="badge" style="background-color: #EDE9DF; color: #4B4E47; border: 1px solid #D5D1C6; font-size: 0.75rem;">
                Anexo E.1 Oficial
            </span>
        </div>
        <p class="text-muted mb-0" style="font-size: 0.88rem;">
            Control de acceso basado en roles con comprobación obligatoria en servidor y auditoría transaccional.
        </p>
    </div>
    <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
        <a asp-action="Usuarios" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1 shadow-sm">
            <i class="bi bi-people"></i>
            <span>Ver Cuentas de Usuario</span>
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Tabla de Roles en Base de Datos -->
    <div class="col-lg-5">
        <div class="card shadow-sm border-0 h-100" style="background: #FFFFFF; border: 1px solid #E2DFD6 !important; border-radius: 8px;">
            <div class="card-header py-3 px-3 px-md-4 d-flex justify-content-between align-items-center" style="background: #FAF9F5; border-bottom: 1px solid #E2DFD6;">
                <h6 class="m-0 fw-bold" style="color: #2C2D2A;">Roles Registrados (dbo.Roles)</h6>
                <span class="badge" style="background-color: #2E4636; color: #FFFFFF;">@Model.Count() Roles</span>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover align-middle m-0" style="font-size: 0.88rem;">
                    <thead style="background: #FAF9F5; border-bottom: 2px solid #E2DFD6;">
                        <tr>
                            <th class="ps-3">Rol</th>
                            <th>Descripción Funcional</th>
                            <th class="text-center pe-3">Usuarios</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-dark">
                                    <span class="badge fw-bold" style="background: #FAF9F5; color: #2E4636; border: 1px solid #C9C5B9;">@r.NombreRol</span>
                                </td>
                                <td class="text-muted small">@r.Descripcion</td>
                                <td class="text-center pe-3">
                                    <span class="badge" style="background-color: #EDE8DC; color: #4B4E47; border: 1px solid #D5D1C6;">@r.CantidadUsuarios</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer py-2 px-3 bg-light text-muted small" style="border-top: 1px solid #E2DFD6; font-size: 0.78rem;">
                <i class="bi bi-check-circle text-success me-1"></i> Verificación obligatoria de autorización por atributo <code>[Authorize(Roles = "...")]</code>.
            </div>
        </div>
    </div>

    <!-- Matriz de Acceso Oficial Anexo E.1 -->
    <div class="col-lg-7">
        <div class="card shadow-sm border-0 h-100" style="background: #FFFFFF; border: 1px solid #E2DFD6 !important; border-radius: 8px;">
            <div class="card-header py-3 px-3 px-md-4 d-flex justify-content-between align-items-center" style="background: #FAF9F5; border-bottom: 1px solid #E2DFD6;">
                <h6 class="m-0 fw-bold" style="color: #2C2D2A;">Matriz Oficial de Permisos por Módulo</h6>
                <span class="badge" style="background-color: #C89D3C; color: #FFFFFF;">Pliego UAGRM</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered align-middle m-0" style="font-size: 0.85rem; border-color: #E2DFD6;">
                        <thead style="background: #FAF9F5;">
                            <tr>
                                <th class="ps-3" style="width: 40%;">Módulo Operativo</th>
                                <th class="text-center" style="width: 20%;">Administrador</th>
                                <th class="text-center" style="width: 20%;">Consultor</th>
                                <th class="text-center" style="width: 20%;">Operador / Campo</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="ps-3 fw-semibold text-dark">1. Inicio (Panel Principal)</td>
                                <td class="text-center"><span class="badge" style="background-color: #D1FAE5; color: #065F46; border: 1px solid #A7F3D0;"><i class="bi bi-check2"></i> Permitido</span></td>
                                <td class="text-center"><span class="badge" style="background-color: #D1FAE5; color: #065F46; border: 1px solid #A7F3D0;"><i class="bi bi-check2"></i> Permitido</span></td>
                                <td class="text-center"><span class="badge" style="background-color: #D1FAE5; color: #065F46; border: 1px solid #A7F3D0;"><i class="bi bi-check2"></i> Permitido</span></td>
                            </tr>
                            <tr>
                                <td class="ps-3 fw-semibold text-dark">2. Visor Cartográfico</td>
                                <td class="text-center"><span class="badge" style="background-color: #D1FAE5; color: #065F46; border: 1px solid #A7F3D0;"><i class="bi bi-check2"></i> Permitido</span></td>
                                <td class="text-center"><span class="badge" style="background-color: #D1FAE5; color: #065F46; border: 1px solid #A7F3D0;"><i class="bi bi-check2"></i> Permitido</span></td>
                                <td class="text-center"><span class="badge" style="background-color: #D1FAE5; color: #065F46; border: 1px solid #A7F3D0;"><i class="bi bi-check2"></i> Permitido</span></td>
                            </tr>
                            <tr>
                                <td class="ps-3 fw-semibold text-dark">3. Consultas y Exportación</td>
                                <td class="text-center"><span class="badge" style="background-color: #D1FAE5; color: #065F46; border: 1px solid #A7F3D0;"><i class="bi bi-check2"></i> Permitido</span></td>
                                <td class="text-center"><span class="badge" style="background-color: #D1FAE5; color: #065F46; border: 1px solid #A7F3D0;"><i class="bi bi-check2"></i> Permitido</span></td>
                                <td class="text-center"><span class="badge" style="background-color: #D1FAE5; color: #065F46; border: 1px solid #A7F3D0;"><i class="bi bi-check2"></i> Permitido</span></td>
                            </tr>
                            <tr>
                                <td class="ps-3 fw-semibold text-dark">4. Usuarios y Roles</td>
                                <td class="text-center"><span class="badge" style="background-color: #D1FAE5; color: #065F46; border: 1px solid #A7F3D0;"><i class="bi bi-check2"></i> Permitido</span></td>
                                <td class="text-center"><span class="badge" style="background-color: #F1F5F9; color: #64748B;"><i class="bi bi-dash-circle"></i> Bloqueado</span></td>
                                <td class="text-center"><span class="badge" style="background-color: #F1F5F9; color: #64748B;"><i class="bi bi-dash-circle"></i> Bloqueado</span></td>
                            </tr>
                            <tr>
                                <td class="ps-3 fw-semibold text-dark">5. Catálogo de Capas</td>
                                <td class="text-center"><span class="badge" style="background-color: #D1FAE5; color: #065F46; border: 1px solid #A7F3D0;"><i class="bi bi-check2"></i> Permitido</span></td>
                                <td class="text-center"><span class="badge" style="background-color: #F1F5F9; color: #64748B;"><i class="bi bi-dash-circle"></i> Bloqueado</span></td>
                                <td class="text-center"><span class="badge" style="background-color: #F1F5F9; color: #64748B;"><i class="bi bi-dash-circle"></i> Bloqueado</span></td>
                            </tr>
                            <tr>
                                <td class="ps-3 fw-semibold text-dark">6. Bitácora de Auditoría</td>
                                <td class="text-center"><span class="badge" style="background-color: #D1FAE5; color: #065F46; border: 1px solid #A7F3D0;"><i class="bi bi-check2"></i> Permitido</span></td>
                                <td class="text-center"><span class="badge" style="background-color: #F1F5F9; color: #64748B;"><i class="bi bi-dash-circle"></i> Bloqueado</span></td>
                                <td class="text-center"><span class="badge" style="background-color: #F1F5F9; color: #64748B;"><i class="bi bi-dash-circle"></i> Bloqueado</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer py-2 px-3 bg-light text-muted small" style="border-top: 1px solid #E2DFD6; font-size: 0.78rem;">
                <i class="bi bi-shield-check text-primary me-1"></i> Las solicitudes no autorizadas son interceptadas por el middleware de autenticación retornando <code>403 Prohibido</code>.
            </div>
        </div>
    </div>
</div>
