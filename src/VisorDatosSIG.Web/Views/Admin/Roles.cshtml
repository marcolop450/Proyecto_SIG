@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Perfiles y Permisos (RBAC)";
}

<div class="row mb-3 align-items-center">
    <div class="col">
        <h4 class="m-0" style="font-weight: 700; color: #2C2D2A;">
            <i class="bi bi-shield-lock me-2 text-primary"></i>
            Perfiles y Permisos
        </h4>
        <p class="text-muted small mb-0">
            Control de acceso basado en roles (RBAC) con comprobación obligatoria en servidor.
        </p>
    </div>
</div>

<div class="row g-3">
    <!-- Tabla de Roles en Base de Datos -->
    <div class="col-md-5">
        <div class="card shadow-sm border h-100">
            <div class="card-header bg-white py-2">
                <strong class="small text-uppercase" style="letter-spacing: 0.5px; color: #4B4E47;">
                    Roles Registrados (dbo.Roles)
                </strong>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm table-hover align-middle m-0" style="font-size: 0.88rem;">
                    <thead style="background: #FAF9F5;">
                        <tr>
                            <th class="ps-3">Rol</th>
                            <th>Descripción</th>
                            <th class="text-center pe-3">Usuarios</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">@r.NombreRol</td>
                                <td class="text-muted small">@r.Descripcion</td>
                                <td class="text-center pe-3">
                                    <span class="badge bg-secondary">@r.CantidadUsuarios</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Matriz de Acceso Oficial Anexo E.1 -->
    <div class="col-md-7">
        <div class="card shadow-sm border h-100">
            <div class="card-header bg-white py-2">
                <strong class="small text-uppercase" style="letter-spacing: 0.5px; color: #4B4E47;">
                    Matriz Resumida de Acceso por Perfil
                </strong>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm table-bordered m-0 align-middle" style="font-size: 0.85rem;">
                    <thead style="background: #FAF9F5;">
                        <tr>
                            <th class="ps-3">Módulo del Sistema</th>
                            <th class="text-center">Administrador</th>
                            <th class="text-center">Consultor</th>
                            <th class="text-center">Operador / Campo</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="ps-3">1. Inicio (Panel Principal)</td>
                            <td class="text-center text-success fw-bold"><i class="bi bi-check-circle"></i> Permitido</td>
                            <td class="text-center text-success fw-bold"><i class="bi bi-check-circle"></i> Permitido</td>
                            <td class="text-center text-success fw-bold"><i class="bi bi-check-circle"></i> Permitido</td>
                        </tr>
                        <tr>
                            <td class="ps-3">2. Visor Cartográfico</td>
                            <td class="text-center text-success fw-bold"><i class="bi bi-check-circle"></i> Permitido</td>
                            <td class="text-center text-success fw-bold"><i class="bi bi-check-circle"></i> Permitido</td>
                            <td class="text-center text-success fw-bold"><i class="bi bi-check-circle"></i> Permitido</td>
                        </tr>
                        <tr>
                            <td class="ps-3">3. Consultas y Exportación</td>
                            <td class="text-center text-success fw-bold"><i class="bi bi-check-circle"></i> Permitido</td>
                            <td class="text-center text-success fw-bold"><i class="bi bi-check-circle"></i> Permitido</td>
                            <td class="text-center text-success fw-bold"><i class="bi bi-check-circle"></i> Permitido</td>
                        </tr>
                        <tr style="background: #FDF8F7;">
                            <td class="ps-3">4. Usuarios y Perfiles</td>
                            <td class="text-center text-success fw-bold"><i class="bi bi-check-circle"></i> Permitido</td>
                            <td class="text-center text-danger fw-bold"><i class="bi bi-x-circle"></i> Bloqueado</td>
                            <td class="text-center text-danger fw-bold"><i class="bi bi-x-circle"></i> Bloqueado</td>
                        </tr>
                        <tr style="background: #FDF8F7;">
                            <td class="ps-3">4. Catálogo de Capas</td>
                            <td class="text-center text-success fw-bold"><i class="bi bi-check-circle"></i> Permitido</td>
                            <td class="text-center text-danger fw-bold"><i class="bi bi-x-circle"></i> Bloqueado</td>
                            <td class="text-center text-danger fw-bold"><i class="bi bi-x-circle"></i> Bloqueado</td>
                        </tr>
                        <tr style="background: #FDF8F7;">
                            <td class="ps-3">4. Historial y Bitácora</td>
                            <td class="text-center text-success fw-bold"><i class="bi bi-check-circle"></i> Permitido</td>
                            <td class="text-center text-danger fw-bold"><i class="bi bi-x-circle"></i> Bloqueado</td>
                            <td class="text-center text-danger fw-bold"><i class="bi bi-x-circle"></i> Bloqueado</td>
                        </tr>
                        <tr>
                            <td class="ps-3">5. Mi Perfil / Salir</td>
                            <td class="text-center text-success fw-bold"><i class="bi bi-check-circle"></i> Permitido</td>
                            <td class="text-center text-success fw-bold"><i class="bi bi-check-circle"></i> Permitido</td>
                            <td class="text-center text-success fw-bold"><i class="bi bi-check-circle"></i> Permitido</td>
                        </tr>
                        <tr>
                            <td class="ps-3">6. Ayuda y Manual</td>
                            <td class="text-center text-success fw-bold"><i class="bi bi-check-circle"></i> Permitido</td>
                            <td class="text-center text-success fw-bold"><i class="bi bi-check-circle"></i> Permitido</td>
                            <td class="text-center text-success fw-bold"><i class="bi bi-check-circle"></i> Permitido</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
