@{
    ViewData["Title"] = "Configuración del Sistema";
    var stats = ViewBag.Stats as VisorDatosSIG.Application.DTOs.EstadisticasCapasDto;
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h4 class="mb-1" style="font-weight: 700; color: #2C2D2A;">
            <i class="bi bi-gear me-2" style="color: var(--primary);"></i>
            Configuración y Parámetros del Sistema
        </h4>
        <p class="text-muted mb-0" style="font-size: 0.88rem;">
            Diagnóstico de conectividad, parámetros espaciales OGC y catálogo de persistencia
        </p>
    </div>
</div>

<div class="row g-4">
    <!-- Parámetros del Motor de Datos -->
    <div class="col-md-6">
        <div class="card shadow-sm" style="background: #FFFFFF; border: 1px solid #E2DFD6;">
            <div class="card-header py-3 d-flex justify-content-between align-items-center" style="background: #FAF9F5; border-bottom: 1px solid #E2DFD6;">
                <h6 class="m-0 fw-bold d-flex align-items-center gap-2" style="color: #383B34;">
                    <i class="bi bi-database"></i>
                    Motor de Base de Datos Espacial
                </h6>
                <span class="badge bg-success d-inline-flex align-items-center gap-1">
                    <i class="bi bi-check-circle"></i> En Línea
                </span>
            </div>
            <div class="card-body p-3">
                <table class="table table-sm table-borderless m-0" style="font-size: 0.88rem;">
                    <tr>
                        <td class="text-muted" style="width: 45%;">Motor RDBMS:</td>
                        <td><strong>Microsoft SQL Server 2022</strong></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Instancia:</td>
                        <td><code>localhost (MSSQLSERVER)</code></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Base de Datos:</td>
                        <td><code>VisorDatosSIG</code></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Tipo Geométrico:</td>
                        <td><code>geometry (Plano Cartesiano OGC)</code></td>
                    </tr>
                    <tr>
                        <td class="text-muted">SRID de Referencia:</td>
                        <td><span class="badge" style="background-color: #5E7A4A;">EPSG:4326 (WGS 84)</span></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Índices Espaciales:</td>
                        <td><code>GEOMETRY_GRID (SIX_*)</code></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Autenticación BD:</td>
                        <td><code>Windows Integrated Security</code></td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <!-- Catálogo de Capas Activas -->
    <div class="col-md-6">
        <div class="card shadow-sm" style="background: #FFFFFF; border: 1px solid #E2DFD6;">
            <div class="card-header py-3 d-flex justify-content-between align-items-center" style="background: #FAF9F5; border-bottom: 1px solid #E2DFD6;">
                <h6 class="m-0 fw-bold d-flex align-items-center gap-2" style="color: #383B34;">
                    <i class="bi bi-layers"></i>
                    Capas Cartográficas Publicadas
                </h6>
                <span class="badge" style="background-color: #5E7A4A;">4 Capas Validadas</span>
            </div>
            <div class="card-body p-3">
                <table class="table table-sm table-borderless m-0" style="font-size: 0.88rem;">
                    <tr>
                        <td class="text-muted" style="width: 50%;">Manzanas Urbanas:</td>
                        <td><strong>@(stats?.TotalManzanas ?? 0)</strong> polígonos</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Lotes Catastrales:</td>
                        <td><strong>@(stats?.TotalLotes ?? 0)</strong> parcelas</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Códigos Fijos (Medidores):</td>
                        <td><strong>@(stats?.TotalCodigosFijos ?? 0)</strong> puntos</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Red Vial / Ejes:</td>
                        <td><strong>@(stats?.TotalVias ?? 0)</strong> vías</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Protocolo de Servicio:</td>
                        <td><code>REST GeoJSON (RFC 7946)</code></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Proveedores Base:</td>
                        <td>OpenStreetMap / OpenTopoMap / Esri</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>
