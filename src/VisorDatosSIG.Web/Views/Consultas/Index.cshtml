@model IEnumerable<VisorDatosSIG.Application.DTOs.InmuebleSearchResultDto>
@{
    ViewData["Title"] = "Consulta Temática";
    var listaUv = ViewBag.ListaUV as List<string> ?? new List<string>();
    var listaMza = ViewBag.ListaMZA as List<string> ?? new List<string>();
    var listaLotes = ViewBag.ListaLotes as List<string> ?? new List<string>();
}

<div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
    <div class="d-flex align-items-center gap-2">
        <h4 class="m-0" style="font-weight: 700; color: #2C2D2A;">
            <i class="bi bi-search me-2" style="color: var(--primary);"></i>
            Consulta Temática de Inmuebles
        </h4>
        <span class="badge" style="background-color: #EDE9DE; color: #4B4E47; border: 1px solid #D5D1C6;">Catastro Municipal</span>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-sand btn-sm d-flex align-items-center gap-1" onclick="exportarCSV()">
            <i class="bi bi-file-earmark-spreadsheet"></i>
            Exportar CSV
        </button>
        <button type="button" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1" onclick="limpiarFiltros()">
            <i class="bi bi-arrow-counterclockwise"></i>
            Limpiar
        </button>
    </div>
</div>

<!-- Barra de Filtros -->
<div class="card shadow-sm mb-3" style="background: #FFFFFF; border: 1px solid #E2DFD6;">
    <div class="card-header py-2 px-3 d-flex justify-content-between align-items-center" style="background: #FAF9F5; border-bottom: 1px solid #E2DFD6;">
        <span class="fw-bold small text-uppercase" style="color: #4B4E47; letter-spacing: 0.5px;">
            <i class="bi bi-funnel me-1"></i>
            Criterios de Filtrado
        </span>
        <span class="small text-muted" id="lblContadorResultados">
            Total filtrados: <strong id="lblCantRegistros">@Model.Count()</strong> predios
            <span id="spinnerBusqueda" class="spinner-border spinner-border-sm text-primary ms-1" style="display: none;" role="status"></span>
        </span>
    </div>
    <div class="card-body p-3">
        <div class="row g-2 align-items-end">
            <!-- Texto (Código o Titular) - NO COMBOBOX -->
            <div class="col-md-4">
                <label for="filtroTexto" class="form-label small fw-bold text-muted mb-1">
                    Código Fijo o Titular
                </label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white">
                        <img src="~/logo.svg" alt="SIG" style="width: 16px; height: 16px; vertical-align: middle;" />
                    </span>
                    <input type="text" id="filtroTexto" value="@ViewBag.Texto" class="form-control" placeholder="Escriba código o nombre..." autofocus autocomplete="off" />
                </div>
            </div>

            <!-- UV - COMBOBOX CON LISTA DE LO QUE EXISTE -->
            <div class="col-md-3">
                <label for="filtroUV" class="form-label small fw-bold text-muted mb-1">
                    Unidad Vecinal (UV)
                </label>
                <select id="filtroUV" class="form-select form-select-sm" style="background: #FAF9F5; border-color: #C9C5B9;">
                    <option value="">[ Todas las UVs ]</option>
                    @foreach (var uv in listaUv)
                    {
                        if (ViewBag.UV == uv)
                        {
                            <option value="@uv" selected>@uv</option>
                        }
                        else
                        {
                            <option value="@uv">@uv</option>
                        }
                    }
                </select>
            </div>

            <!-- MANZANA - COMBOBOX DINÁMICO QUE SÓLO CONTIENE PREDIOS REALES -->
            <div class="col-md-3">
                <label for="filtroMZA" class="form-label small fw-bold text-muted mb-1">
                    Manzana (MZA)
                </label>
                <select id="filtroMZA" class="form-select form-select-sm" style="background: #FAF9F5; border-color: #C9C5B9;">
                    <option value="">[ Todas las Manzanas ]</option>
                    @foreach (var mza in listaMza)
                    {
                        if (ViewBag.Mza == mza)
                        {
                            <option value="@mza" selected>@mza</option>
                        }
                        else
                        {
                            <option value="@mza">@mza</option>
                        }
                    }
                </select>
            </div>

            <!-- LOTE - DATALIST -->
            <div class="col-md-2">
                <label for="filtroLote" class="form-label small fw-bold text-muted mb-1">
                    Lote
                </label>
                <input type="text" id="filtroLote" list="dlLotes" value="@ViewBag.Lote" class="form-control form-control-sm" placeholder="Todos los lotes" autocomplete="off" style="background: #FAF9F5; border-color: #C9C5B9;" />
                <datalist id="dlLotes">
                    @foreach (var lote in listaLotes)
                    {
                        <option value="@lote">@lote</option>
                    }
                </datalist>
            </div>
        </div>
    </div>
</div>

<!-- Tabla de Resultados con Paginación de a 20 -->
<div class="card shadow-sm mb-3" style="background: #FFFFFF; border: 1px solid #E2DFD6;">
    <div class="table-responsive">
        <table class="table table-hover table-custom m-0" id="tablaResultados">
            <thead class="bg-light">
                <tr>
                    <th style="width: 100px;">Código</th>
                    <th>Titular del Servicio</th>
                    <th style="width: 100px;">UV</th>
                    <th style="width: 110px;">Manzana</th>
                    <th style="width: 90px;">Lote</th>
                    <th style="width: 130px;">Estado</th>
                    <th style="width: 110px;">Fecha</th>
                    <th class="text-center" style="width: 130px;">Acción</th>
                </tr>
            </thead>
            <tbody id="cuerpoTabla">
                <!-- Se llena dinámicamente con paginación de a 20 -->
            </tbody>
        </table>
    </div>

    <!-- Barra de Paginación de a 20 -->
    <div class="card-footer py-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2" style="background: #FAF9F5; border-top: 1px solid #E2DFD6;">
        <div class="small text-muted" id="lblInfoPaginacion">
            Cargando registros...
        </div>
        <nav aria-label="Navegación de resultados">
            <ul class="pagination pagination-sm m-0" id="paginadorUI">
                <!-- Botones de página inyectados por JavaScript -->
            </ul>
        </nav>
    </div>
</div>

@section Scripts {
<script>
    let debounceTimer = null;
    let datosActuales = [];
    let paginaActual = 1;
    const tamanoPagina = 20;

    // Datos iniciales precargados desde el servidor
    const datosInicialesDelServidor = [
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <text>{
                    codFijo: @(item.CodFijo.HasValue ? item.CodFijo.Value.ToString() : "null"),
                    nombre: "@Html.Raw(item.Nombre?.Replace("\"", "\\\"") ?? "")",
                    uv: "@Html.Raw(item.UV ?? "-")",
                    mza: "@Html.Raw(item.MZA ?? "-")",
                    nroLote: "@Html.Raw(item.NroLote ?? "-")",
                    estado: @item.Estado,
                    estadoDesc: "@Html.Raw(item.EstadoDesc)",
                    fechaCambioEstado: "@item.FechaCambioEstado.ToString("yyyy-MM-dd")",
                    latitud: @(item.Latitud.HasValue ? item.Latitud.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "null"),
                    longitud: @(item.Longitud.HasValue ? item.Longitud.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "null")
                },</text>
            }
        }
    ];

    document.addEventListener("DOMContentLoaded", function () {
        datosActuales = datosInicialesDelServidor;
        paginaActual = 1;
        renderizarPaginaActual();

        // 1. Escuchar escritura en Texto (Código o Titular) con debounce de 200ms
        const inputTexto = document.getElementById('filtroTexto');
        inputTexto.addEventListener('input', function () {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(ejecutarBusquedaAsincrona, 200);
        });

        // 2. Escuchar cambio en Combobox UV -> Actualiza Manzanas disponibles de esa UV y busca
        document.getElementById('filtroUV').addEventListener('change', function () {
            const uvSel = this.value;
            actualizarComboboxManzanasPorUV(uvSel);
            ejecutarBusquedaAsincrona();
        });

        // 3. Escuchar cambio en Combobox Manzana -> Filtra al instante
        document.getElementById('filtroMZA').addEventListener('change', function () {
            ejecutarBusquedaAsincrona();
        });

        // 4. Escuchar cambio en Lote
        document.getElementById('filtroLote').addEventListener('input', function () {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(ejecutarBusquedaAsincrona, 200);
        });
    });

    // Cascada de UV -> Manzanas (Sólo muestra manzanas con predios existentes)
    function actualizarComboboxManzanasPorUV(uv) {
        const selectMZA = document.getElementById('filtroMZA');
        const valorMzaActual = selectMZA.value;

        fetch('/api/filtros' + (uv ? '?uv=' + encodeURIComponent(uv) : ''))
            .then(res => res.json())
            .then(data => {
                if (data && data.listaMZA) {
                    let html = '<option value="">[ Todas las Manzanas ]</option>';
                    data.listaMZA.forEach(m => {
                        const sel = (m === valorMzaActual) ? ' selected' : '';
                        html += `<option value="${m}"${sel}>${m}</option>`;
                    });
                    selectMZA.innerHTML = html;
                }
            })
            .catch(err => console.error("Error al actualizar manzanas por UV:", err));
    }

    function ejecutarBusquedaAsincrona() {
        const texto = document.getElementById('filtroTexto').value.trim();
        const uv = document.getElementById('filtroUV').value.trim();
        const mza = document.getElementById('filtroMZA').value.trim();
        const lote = document.getElementById('filtroLote').value.trim();

        const spinner = document.getElementById('spinnerBusqueda');
        spinner.style.display = 'inline-block';

        const params = new URLSearchParams();
        if (texto) params.append('texto', texto);
        if (uv) params.append('uv', uv);
        if (mza) params.append('mza', mza);
        if (lote) params.append('lote', lote);

        fetch('/api/busqueda?' + params.toString())
            .then(res => res.json())
            .then(data => {
                spinner.style.display = 'none';
                datosActuales = data || [];
                paginaActual = 1; // Reiniciar a la primera página tras nuevo filtro
                renderizarPaginaActual();
            })
            .catch(err => {
                spinner.style.display = 'none';
                console.error("Error al buscar:", err);
            });
    }

    function renderizarPaginaActual() {
        const tbody = document.getElementById('cuerpoTabla');
        const totalRegistros = datosActuales.length;
        document.getElementById('lblCantRegistros').innerText = totalRegistros;

        if (!datosActuales || totalRegistros === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="8" class="text-center py-4 text-muted">
                        <i class="bi bi-inbox fs-3 d-block mb-1 text-muted"></i>
                        No se encontraron predios con los criterios seleccionados.
                    </td>
                </tr>`;
            document.getElementById('lblInfoPaginacion').innerText = '0 registros encontrados';
            document.getElementById('paginadorUI').innerHTML = '';
            return;
        }

        const totalPaginas = Math.ceil(totalRegistros / tamanoPagina) || 1;
        if (paginaActual > totalPaginas) paginaActual = totalPaginas;
        if (paginaActual < 1) paginaActual = 1;

        const inicio = (paginaActual - 1) * tamanoPagina;
        const fin = Math.min(inicio + tamanoPagina, totalRegistros);
        const itemsPagina = datosActuales.slice(inicio, fin);

        let html = '';
        for (let i = 0; i < itemsPagina.length; i++) {
            const it = itemsPagina[i];
            const cod = it.codFijo || '-';
            const nom = it.nombre || '-';
            const uv = it.uv || '-';
            const mza = it.mza || '-';
            const lote = it.nroLote || '-';
            const fecha = it.fechaCambioEstado ? it.fechaCambioEstado.substring(0, 10) : '-';

            let badgeEstado = '';
            if (it.estado === 1) {
                badgeEstado = '<span class="badge d-inline-flex align-items-center gap-1" style="background-color: #5E7A4A;"><i class="bi bi-check-circle"></i> Normal</span>';
            } else if (it.estado === 2) {
                badgeEstado = '<span class="badge d-inline-flex align-items-center gap-1" style="background-color: #C27D38;"><i class="bi bi-exclamation-circle"></i> Para Corte</span>';
            } else if (it.estado === 3) {
                badgeEstado = '<span class="badge d-inline-flex align-items-center gap-1" style="background-color: #B84A39;"><i class="bi bi-slash-circle"></i> Cortado</span>';
            } else {
                badgeEstado = `<span class="badge bg-secondary">${it.estadoDesc || 'Otro'}</span>`;
            }

            let botonMapa = '-';
            if (it.latitud && it.longitud) {
                const latStr = Number(it.latitud).toFixed(6);
                const lngStr = Number(it.longitud).toFixed(6);
                botonMapa = `<a href="/Mapa?lat=${latStr}&lng=${lngStr}&cod=${cod}" class="btn btn-sm btn-olive py-0 px-2 d-inline-flex align-items-center gap-1" style="font-size: 0.78rem;" title="Ver en mapa"><i class="bi bi-geo-alt"></i> Ver en Mapa</a>`;
            }

            html += `
                <tr>
                    <td class="fw-bold font-monospace" style="color: #2D302B;">${cod}</td>
                    <td>${nom}</td>
                    <td><span class="badge bg-light text-dark border">${uv}</span></td>
                    <td><span class="badge bg-light text-dark border">${mza}</span></td>
                    <td><span class="badge bg-light text-dark border">${lote}</span></td>
                    <td>${badgeEstado}</td>
                    <td class="small text-muted font-monospace">${fecha}</td>
                    <td class="text-center">${botonMapa}</td>
                </tr>`;
        }

        tbody.innerHTML = html;
        document.getElementById('lblInfoPaginacion').innerText = 
            `Mostrando registros ${inicio + 1} - ${fin} de ${totalRegistros} predios (Página ${paginaActual} de ${totalPaginas})`;

        renderizarBotonesPaginador(totalPaginas);
    }

    function renderizarBotonesPaginador(totalPaginas) {
        const ul = document.getElementById('paginadorUI');
        if (totalPaginas <= 1) {
            ul.innerHTML = '';
            return;
        }

        let html = '';

        // Botón Anterior
        const deshabAnt = (paginaActual === 1) ? ' disabled' : '';
        html += `<li class="page-item${deshabAnt}"><button class="page-link" onclick="cambiarPagina(${paginaActual - 1})"><i class="bi bi-chevron-left"></i></button></li>`;

        // Rango de páginas visibles (máximo 7 botones)
        let inicioPag = Math.max(1, paginaActual - 3);
        let finPag = Math.min(totalPaginas, inicioPag + 6);
        if (finPag - inicioPag < 6) {
            inicioPag = Math.max(1, finPag - 6);
        }

        if (inicioPag > 1) {
            html += `<li class="page-item"><button class="page-link" onclick="cambiarPagina(1)">1</button></li>`;
            if (inicioPag > 2) {
                html += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }
        }

        for (let p = inicioPag; p <= finPag; p++) {
            const activa = (p === paginaActual) ? ' active' : '';
            html += `<li class="page-item${activa}"><button class="page-link" onclick="cambiarPagina(${p})">${p}</button></li>`;
        }

        if (finPag < totalPaginas) {
            if (finPag < totalPaginas - 1) {
                html += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }
            html += `<li class="page-item"><button class="page-link" onclick="cambiarPagina(${totalPaginas})">${totalPaginas}</button></li>`;
        }

        // Botón Siguiente
        const deshabSig = (paginaActual === totalPaginas) ? ' disabled' : '';
        html += `<li class="page-item${deshabSig}"><button class="page-link" onclick="cambiarPagina(${paginaActual + 1})"><i class="bi bi-chevron-right"></i></button></li>`;

        ul.innerHTML = html;
    }

    function cambiarPagina(nuevaPagina) {
        paginaActual = nuevaPagina;
        renderizarPaginaActual();
        // Desplazamiento suave al inicio de la tabla
        document.getElementById('tablaResultados').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function limpiarFiltros() {
        document.getElementById('filtroTexto').value = '';
        document.getElementById('filtroUV').value = '';
        document.getElementById('filtroLote').value = '';
        actualizarComboboxManzanasPorUV('');
        document.getElementById('filtroMZA').value = '';
        ejecutarBusquedaAsincrona();
    }

    // Exportación CSV: EXPORTA TODOS LOS REGISTROS FILTRADOS (no sólo la página visible de 20)
    function exportarCSV() {
        if (!datosActuales || datosActuales.length === 0) {
            alert("No hay registros para exportar con los filtros actuales.");
            return;
        }

        let lineas = [];
        // Encabezados
        lineas.push(["Código Fijo", "Titular", "UV", "Manzana", "Lote", "Estado", "Fecha Último Estado", "Latitud", "Longitud"].map(h => `"${h}"`).join(";"));

        // Datos completos del filtro activo
        for (let i = 0; i < datosActuales.length; i++) {
            const it = datosActuales[i];
            const cod = it.codFijo || '';
            const nom = (it.nombre || '').replace(/"/g, '""');
            const uv = (it.uv || '').replace(/"/g, '""');
            const mza = (it.mza || '').replace(/"/g, '""');
            const lote = (it.nroLote || '').replace(/"/g, '""');
            const estado = it.estadoDesc || '';
            const fecha = it.fechaCambioEstado ? it.fechaCambioEstado.substring(0, 10) : '';
            const lat = it.latitud ? Number(it.latitud).toFixed(6) : '';
            const lng = it.longitud ? Number(it.longitud).toFixed(6) : '';

            lineas.push([`"${cod}"`, `"${nom}"`, `"${uv}"`, `"${mza}"`, `"${lote}"`, `"${estado}"`, `"${fecha}"`, `"${lat}"`, `"${lng}"`].join(";"));
        }

        const csvContent = "\uFEFF" + lineas.join("\r\n");
        const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
        const enlace = document.createElement("a");
        enlace.href = URL.createObjectURL(blob);
        enlace.download = `Inmuebles_Export_${new Date().toISOString().substring(0, 10)}.csv`;
        enlace.click();
    }
</script>
}
