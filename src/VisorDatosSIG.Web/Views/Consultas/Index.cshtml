@model IEnumerable<VisorDatosSIG.Application.DTOs.InmuebleSearchResultDto>
@{
    ViewData["Title"] = "Consulta Temática";
}

<div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
    <div>
        <h4 class="mb-1" style="font-weight: 700; color: #2C2D2A;">
            <i class="bi bi-search me-2" style="color: var(--primary);"></i>
            Consulta Temática de Inmuebles
        </h4>
        <p class="text-muted mb-0" style="font-size: 0.88rem;">
            Búsqueda alfanumérica y filtrado espacial por código, titular, UV, manzana o lote
        </p>
    </div>
</div>

<div class="card shadow-sm mb-4" style="background: #FFFFFF; border: 1px solid #E2DFD6;">
    <div class="card-header py-2 px-3" style="background: #FAF9F5; border-bottom: 1px solid #E2DFD6;">
        <span class="fw-bold small text-uppercase" style="color: #4B4E47; letter-spacing: 0.5px;">
            <i class="bi bi-funnel me-1"></i>
            Criterios de Filtrado
        </span>
    </div>
    <div class="card-body p-3">
        <form method="get" asp-action="Index">
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted">Texto (Código o Titular)</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white"><i class="bi bi-person text-muted"></i></span>
                        <input type="text" name="texto" value="@ViewBag.Texto" class="form-control" placeholder="Ej. 1001 o Juan..." style="background: #FAF9F5; border-color: #C9C5B9;" />
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Unidad Vecinal (UV)</label>
                    <input type="text" name="uv" value="@ViewBag.UV" class="form-control form-control-sm" placeholder="Ej. UV-1" style="background: #FAF9F5; border-color: #C9C5B9;" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Manzana</label>
                    <input type="text" name="mza" value="@ViewBag.Mza" class="form-control form-control-sm" placeholder="Ej. MZA-5" style="background: #FAF9F5; border-color: #C9C5B9;" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Lote</label>
                    <input type="text" name="lote" value="@ViewBag.Lote" class="form-control form-control-sm" placeholder="Ej. 12" style="background: #FAF9F5; border-color: #C9C5B9;" />
                </div>
                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-olive btn-sm w-100 py-1 d-flex align-items-center justify-content-center gap-1">
                        <i class="bi bi-search"></i>
                        Buscar
                    </button>
                    <a asp-action="Index" class="btn btn-sand btn-sm py-1 d-flex align-items-center gap-1">
                        <i class="bi bi-x-circle"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="card shadow-sm" style="background: #FFFFFF; border: 1px solid #E2DFD6;">
        <div class="card-header py-2 px-3 d-flex justify-content-between align-items-center" style="background: #FAF9F5; border-bottom: 1px solid #E2DFD6;">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold small" style="color: #4B4E47;">Predios Encontrados:</span>
                <span class="badge" style="background-color: #5E7A4A;">@Model.Count()</span>
            </div>
            <button class="btn btn-sand btn-sm py-1 px-3 d-flex align-items-center gap-1" onclick="exportarCSV()">
                <i class="bi bi-file-earmark-spreadsheet"></i>
                Exportar CSV
            </button>
        </div>
        <div class="table-responsive">
            <table class="table table-hover table-custom m-0" id="tablaResultados">
                <thead>
                    <tr>
                        <th>Código Fijo</th>
                        <th>Titular del Servicio</th>
                        <th>UV</th>
                        <th>Manzana</th>
                        <th>N° Lote</th>
                        <th>Estado de Conexión</th>
                        <th>Último Cambio</th>
                        <th class="text-center">Localización</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.CodFijo</strong></td>
                            <td>@(item.Nombre ?? "-")</td>
                            <td>@(item.UV ?? "-")</td>
                            <td>@(item.MZA ?? "-")</td>
                            <td>@(item.NroLote ?? "-")</td>
                            <td>
                                @if (item.Estado == 1)
                                {
                                    <span class="badge d-inline-flex align-items-center gap-1" style="background-color: #5E7A4A;">
                                        <i class="bi bi-check-circle"></i> Normal
                                    </span>
                                }
                                else if (item.Estado == 2)
                                {
                                    <span class="badge d-inline-flex align-items-center gap-1" style="background-color: #C27D38;">
                                        <i class="bi bi-exclamation-circle"></i> Para Corte
                                    </span>
                                }
                                else if (item.Estado == 3)
                                {
                                    <span class="badge d-inline-flex align-items-center gap-1" style="background-color: #B84A39;">
                                        <i class="bi bi-slash-circle"></i> Cortado
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.EstadoDesc</span>
                                }
                            </td>
                            <td class="small text-muted font-monospace">@item.FechaCambioEstado.ToString("yyyy-MM-dd")</td>
                            <td class="text-center">
                                @if (item.Latitud.HasValue && item.Longitud.HasValue)
                                {
                                    <a href="/Mapa?lat=@item.Latitud&lng=@item.Longitud&cod=@item.CodFijo" class="btn btn-sm btn-olive py-0 px-2 d-inline-flex align-items-center gap-1" style="font-size: 0.78rem;" title="Ver en visor cartográfico">
                                        <i class="bi bi-geo-alt"></i>
                                        Ver en Mapa
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (ViewBag.Texto != null || ViewBag.UV != null || ViewBag.Mza != null || ViewBag.Lote != null)
{
    <div class="alert alert-warning text-center py-4 shadow-sm" style="background: #FDF9F0; border-color: #F0E3C7; color: #8A6818;">
        <i class="bi bi-exclamation-triangle" style="font-size: 2rem;"></i>
        <h6 class="fw-bold mt-2 mb-1">Sin Resultados</h6>
        <p class="mb-0 small">No se encontraron predios que coincidan con los criterios de búsqueda especificados.</p>
    </div>
}
else
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-search" style="font-size: 2.5rem; color: #C9C5B9;"></i>
        <p class="mt-2 mb-0">Especifique uno o varios filtros arriba y presione <strong>Buscar</strong> para consultar la base de datos.</p>
    </div>
}

@section Scripts {
<script>
    function exportarCSV() {
        let tabla = document.getElementById("tablaResultados");
        if (!tabla) return;
        let csv = [];
        for (let row of tabla.rows) {
            let cols = [];
            for (let cell of row.cells) {
                cols.push('"' + cell.innerText.replace(/"/g, '""').trim() + '"');
            }
            csv.push(cols.join(","));
        }
        let blob = new Blob([csv.join("\n")], { type: "text/csv;charset=utf-8;" });
        let url = URL.createObjectURL(blob);
        let link = document.createElement("a");
        link.setAttribute("href", url);
        link.setAttribute("download", "Reporte_Predios_VisorDatosSIG.csv");
        link.click();
    }
</script>
}
