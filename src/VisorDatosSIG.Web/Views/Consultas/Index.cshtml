@model IEnumerable<VisorDatosSIG.Application.DTOs.InmuebleSearchResultDto>
@{
    ViewData["Title"] = "Consulta Temática";
    var listaUv = ViewBag.ListaUV as List<string> ?? new List<string>();
    var listaMza = ViewBag.ListaMZA as List<string> ?? new List<string>();
    var listaLotes = ViewBag.ListaLotes as List<string> ?? new List<string>();
}

<div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
    <div class="d-flex align-items-center gap-2">
        <h4 class="m-0" style="font-weight: 700; color: #2C2D2A;">
            <i class="bi bi-search me-2" style="color: var(--primary);"></i>
            Consulta Temática de Inmuebles
        </h4>
        <span class="badge" style="background-color: #EDE9DE; color: #4B4E47; border: 1px solid #D5D1C6;">Catastro y Suministros</span>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-sand btn-sm d-flex align-items-center gap-1" onclick="exportarCSV()">
            <i class="bi bi-file-earmark-spreadsheet"></i>
            Exportar CSV
        </button>
        <button type="button" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1" onclick="limpiarFiltros()">
            <i class="bi bi-arrow-counterclockwise"></i>
            Limpiar
        </button>
    </div>
</div>

<!-- Barra de Filtros -->
<div class="card shadow-sm mb-3" style="background: #FFFFFF; border: 1px solid #E2DFD6;">
    <div class="card-header py-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2" style="background: #FAF9F5; border-bottom: 1px solid #E2DFD6;">
        <div class="d-flex align-items-center flex-wrap gap-2">
            <span class="fw-bold small text-uppercase" style="color: #4B4E47; letter-spacing: 0.5px;">
                <i class="bi bi-funnel me-1"></i>
                Criterios de Filtrado
            </span>
            <div class="btn-group btn-group-sm ms-2 flex-wrap" role="group" id="btnGroupTipoPredio">
                <button type="button" class="btn btn-sm btn-olive active" id="btnTipoTodos" onclick="cambiarTipoPredio('TODOS')">
                    Todos los Predios (15,280)
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnTipoConSum" onclick="cambiarTipoPredio('CON_SUMINISTRO')">
                    Con Suministro
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnTipoSinSum" onclick="cambiarTipoPredio('SIN_SUMINISTRO')">
                    Sin Medidor / Baldíos
                </button>
                <button type="button" class="btn btn-sm btn-outline-warning" id="btnTipoParaCorte" onclick="cambiarTipoPredio('PARA_CORTE')">
                    <i class="bi bi-exclamation-triangle me-1"></i>Para Corte
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger" id="btnTipoCortado" onclick="cambiarTipoPredio('CORTADO')">
                    <i class="bi bi-slash-circle me-1"></i>Cortados
                </button>
            </div>
            <input type="hidden" id="filtroTipoPredio" value="@(ViewBag.TipoPredio ?? "TODOS")" />
        </div>
        <span class="small text-muted" id="lblContadorResultados">
            Total filtrados: <strong id="lblCantRegistros">0</strong> predios
            <span id="spinnerBusqueda" class="spinner-border spinner-border-sm text-primary ms-1" style="display: none;" role="status"></span>
        </span>
    </div>
    <div class="card-body p-3">
        <div class="row g-2 align-items-end">
            <!-- Texto (Código Fijo, ID o Titular) -->
            <div class="col-md-3">
                <label for="filtroTexto" class="form-label small fw-bold text-muted mb-1">
                    Código Fijo, ID o Titular
                </label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white">
                        <img src="~/logo.svg" alt="SIG" style="width: 16px; height: 16px; vertical-align: middle;" />
                    </span>
                    <input type="text" id="filtroTexto" value="@ViewBag.Texto" class="form-control" placeholder="Ej. 4936, Ubaldo..." autofocus autocomplete="off" />
                </div>
            </div>

            <!-- UV -->
            <div class="col-md-2">
                <label for="filtroUV" class="form-label small fw-bold text-muted mb-1">
                    Unidad Vecinal (UV)
                </label>
                <select id="filtroUV" class="form-select form-select-sm" style="background: #FAF9F5; border-color: #C9C5B9;">
                    <option value="">[ Todas las UVs ]</option>
                    @foreach (var uv in listaUv)
                    {
                        if (ViewBag.UV == uv)
                        {
                            <option value="@uv" selected>@uv</option>
                        }
                        else
                        {
                            <option value="@uv">@uv</option>
                        }
                    }
                </select>
            </div>

            <!-- MANZANA -->
            <div class="col-md-2">
                <label for="filtroMZA" class="form-label small fw-bold text-muted mb-1">
                    Manzana (MZA)
                </label>
                <select id="filtroMZA" class="form-select form-select-sm" style="background: #FAF9F5; border-color: #C9C5B9;">
                    <option value="">[ Todas las Manzanas ]</option>
                    @foreach (var mza in listaMza)
                    {
                        if (ViewBag.Mza == mza)
                        {
                            <option value="@mza" selected>@mza</option>
                        }
                        else
                        {
                            <option value="@mza">@mza</option>
                        }
                    }
                </select>
            </div>

            <!-- LOTE -->
            <div class="col-md-2">
                <label for="filtroLote" class="form-label small fw-bold text-muted mb-1">
                    Lote
                </label>
                <input type="text" id="filtroLote" list="dlLotes" value="@ViewBag.Lote" class="form-control form-control-sm" placeholder="Todos los lotes" autocomplete="off" style="background: #FAF9F5; border-color: #C9C5B9;" />
                <datalist id="dlLotes">
                    @foreach (var lote in listaLotes)
                    {
                        <option value="@lote">@lote</option>
                    }
                </datalist>
            </div>

            <!-- ESTADO DE SUMINISTRO -->
            <div class="col-md-3">
                <label for="filtroEstado" class="form-label small fw-bold text-muted mb-1">
                    Estado de Suministro
                </label>
                <select id="filtroEstado" class="form-select form-select-sm" style="background: #FAF9F5; border-color: #C9C5B9;">
                    <option value="">[ Todos los Estados ]</option>
                    <option value="1">Normal (Activo)</option>
                    <option value="2">Para Corte (Mora)</option>
                    <option value="3">Cortado (Suspención)</option>
                    <option value="4">Baja Parcial / Total</option>
                    <option value="0">Sin Suministro / Baldío</option>
                </select>
            </div>
        </div>
    </div>
</div>

<!-- Tabla de Resultados con Paginación de a 20 -->
<div class="card shadow-sm mb-3" style="background: #FFFFFF; border: 1px solid #E2DFD6;">
    <div class="table-responsive">
        <table class="table table-hover table-custom m-0" id="tablaResultados">
            <thead class="bg-light">
                <tr>
                    <th style="width: 100px;">Código Fijo</th>
                    <th>Titular del Servicio</th>
                    <th style="width: 90px;">UV</th>
                    <th style="width: 100px;">Manzana</th>
                    <th style="width: 80px;">Lote</th>
                    <th style="width: 130px;">Estado</th>
                    <th style="width: 110px;">Fecha Estado</th>
                    <th class="text-center" style="width: 190px;">Acciones</th>
                </tr>
            </thead>
            <tbody id="cuerpoTabla">
                <tr>
                    <td colspan="8" class="text-center py-4 text-muted">
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        Cargando catálogo catastral...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Barra de Paginación de a 20 -->
    <div class="card-footer py-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2" style="background: #FAF9F5; border-top: 1px solid #E2DFD6;">
        <div class="small text-muted" id="lblInfoPaginacion">
            Iniciando...
        </div>
        <nav aria-label="Navegación de resultados">
            <ul class="pagination pagination-sm m-0" id="paginadorUI">
            </ul>
        </nav>
    </div>
</div>

<!-- Modal para Cambio de Estado de Suministro (Corte / Reconexión) -->
<div class="modal fade" id="modalCambioEstado" tabindex="-1" aria-labelledby="modalCambioEstadoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border: 1px solid #C9C5B9;">
            <div class="modal-header py-2 px-3" style="background: #FAF9F5; border-bottom: 1px solid #E2DFD6;">
                <h6 class="modal-title fw-bold" id="modalCambioEstadoLabel" style="color: #2C2D2A;">
                    <i class="bi bi-toggles me-1 text-primary"></i>
                    Actualizar Estado de Suministro
                </h6>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <input type="hidden" id="modalCodFijo" />
                <div class="mb-2">
                    <span class="text-muted small">Código Fijo:</span>
                    <strong id="modalTxtCodFijo" class="font-monospace ms-1">-</strong>
                </div>
                <div class="mb-3">
                    <span class="text-muted small">Titular:</span>
                    <strong id="modalTxtTitular" class="ms-1">-</strong>
                </div>
                <div class="mb-3">
                    <label for="modalSelEstado" class="form-label small fw-bold text-muted mb-1">
                        Nuevo Estado Operativo
                    </label>
                    <select id="modalSelEstado" class="form-select form-select-sm">
                        <option value="1">1 - Normal (Servicio Activo)</option>
                        <option value="2">2 - Para Corte (Notificación de Mora)</option>
                        <option value="3">3 - Cortado (Suministro Suspendido)</option>
                        <option value="4">4 - Baja Parcial</option>
                        <option value="5">5 - Baja Total</option>
                    </select>
                </div>
                <div class="mb-2">
                    <label for="modalTxtMotivo" class="form-label small fw-bold text-muted mb-1">
                        Motivo / Observación de Campo
                    </label>
                    <textarea id="modalTxtMotivo" class="form-control form-control-sm" rows="2" placeholder="Ej. Orden de corte por mora de 3 facturas o Reconexión por pago verificado..."></textarea>
                </div>
                <div id="modalAlertError" class="alert alert-danger py-1 px-2 small mb-0" style="display: none;"></div>
            </div>
            <div class="modal-footer py-2 px-3" style="background: #FAF9F5; border-top: 1px solid #E2DFD6;">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-sm btn-olive d-flex align-items-center gap-1" id="btnGuardarCambioEstado" onclick="guardarCambioEstado()">
                    <i class="bi bi-check2-circle"></i>
                    Guardar Estado
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let debounceTimer = null;
    let datosActuales = [];
    let paginaActual = 1;
    const tamanoPagina = 20;

    document.addEventListener("DOMContentLoaded", function () {
        // Carga asíncrona inmediata sin bloquear el HTML
        ejecutarBusquedaAsincrona();

        // 1. Escuchar escritura en Texto (Código, ID o Titular) con debounce
        const inputTexto = document.getElementById('filtroTexto');
        inputTexto.addEventListener('input', function () {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(ejecutarBusquedaAsincrona, 250);
        });

        // 2. Escuchar cambio en Combobox UV
        document.getElementById('filtroUV').addEventListener('change', function () {
            const uvSel = this.value;
            actualizarComboboxManzanasPorUV(uvSel);
            ejecutarBusquedaAsincrona();
        });

        // 3. Escuchar cambio en Combobox Manzana
        document.getElementById('filtroMZA').addEventListener('change', function () {
            ejecutarBusquedaAsincrona();
        });

        // 4. Escuchar cambio en Lote
        document.getElementById('filtroLote').addEventListener('input', function () {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(ejecutarBusquedaAsincrona, 250);
        });

        // 5. Escuchar cambio en Estado
        document.getElementById('filtroEstado').addEventListener('change', function () {
            ejecutarBusquedaAsincrona();
        });
    });

    // Cambiar tipo de predio (Todos, Con Suministro, Sin Suministro, Para Corte, Cortado)
    function cambiarTipoPredio(tipo) {
        document.getElementById('filtroTipoPredio').value = tipo;
        
        const botones = {
            'TODOS': 'btnTipoTodos',
            'CON_SUMINISTRO': 'btnTipoConSum',
            'SIN_SUMINISTRO': 'btnTipoSinSum',
            'PARA_CORTE': 'btnTipoParaCorte',
            'CORTADO': 'btnTipoCortado'
        };

        for (let k in botones) {
            const btn = document.getElementById(botones[k]);
            if (!btn) continue;
            if (k === tipo) {
                if (k === 'PARA_CORTE') btn.className = 'btn btn-sm btn-warning active';
                else if (k === 'CORTADO') btn.className = 'btn btn-sm btn-danger active';
                else btn.className = 'btn btn-sm btn-olive active';
            } else {
                if (k === 'PARA_CORTE') btn.className = 'btn btn-sm btn-outline-warning';
                else if (k === 'CORTADO') btn.className = 'btn btn-sm btn-outline-danger';
                else btn.className = 'btn btn-sm btn-outline-secondary';
            }
        }

        ejecutarBusquedaAsincrona();
    }

    // Cascada de UV -> Manzanas
    function actualizarComboboxManzanasPorUV(uv) {
        const selectMZA = document.getElementById('filtroMZA');
        const valorMzaActual = selectMZA.value;

        fetch('/api/filtros' + (uv ? '?uv=' + encodeURIComponent(uv) : ''))
            .then(res => res.json())
            .then(data => {
                if (data && data.listaMZA) {
                    let html = '<option value="">[ Todas las Manzanas ]</option>';
                    data.listaMZA.forEach(m => {
                        const sel = (m === valorMzaActual) ? ' selected' : '';
                        html += `<option value="${m}"${sel}>${m}</option>`;
                    });
                    selectMZA.innerHTML = html;
                }
            })
            .catch(err => console.error("Error al actualizar manzanas por UV:", err));
    }

    function ejecutarBusquedaAsincrona() {
        const texto = document.getElementById('filtroTexto').value.trim();
        const uv = document.getElementById('filtroUV').value.trim();
        const mza = document.getElementById('filtroMZA').value.trim();
        const lote = document.getElementById('filtroLote').value.trim();
        const tipoPredio = document.getElementById('filtroTipoPredio').value.trim();
        const estadoSel = document.getElementById('filtroEstado').value.trim();

        const spinner = document.getElementById('spinnerBusqueda');
        spinner.style.display = 'inline-block';

        const params = new URLSearchParams();
        if (texto) params.append('texto', texto);
        if (uv) params.append('uv', uv);
        if (mza) params.append('mza', mza);
        if (lote) params.append('lote', lote);
        if (tipoPredio) params.append('tipoPredio', tipoPredio);

        fetch('/api/busqueda?' + params.toString())
            .then(res => res.json())
            .then(data => {
                spinner.style.display = 'none';
                let items = data || [];

                // Filtro secundario si seleccionó estado específico en el combo
                if (estadoSel !== '') {
                    const estNum = parseInt(estadoSel);
                    items = items.filter(x => x.estado === estNum);
                }

                datosActuales = items;
                paginaActual = 1;
                renderizarPaginaActual();
            })
            .catch(err => {
                spinner.style.display = 'none';
                console.error("Error al buscar:", err);
                const tbody = document.getElementById('cuerpoTabla');
                tbody.innerHTML = `
                    <tr>
                        <td colspan="8" class="text-center py-4 text-danger">
                            <i class="bi bi-exclamation-triangle fs-3 d-block mb-1"></i>
                            Ocurrió un error al cargar los datos. Intente nuevamente.
                        </td>
                    </tr>`;
                document.getElementById('lblInfoPaginacion').innerText = 'Error al consultar registros';
            });
    }

    function renderizarPaginaActual() {
        const tbody = document.getElementById('cuerpoTabla');
        const totalRegistros = datosActuales.length;
        document.getElementById('lblCantRegistros').innerText = totalRegistros;

        if (!datosActuales || totalRegistros === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="8" class="text-center py-4 text-muted">
                        <i class="bi bi-inbox fs-3 d-block mb-1 text-muted"></i>
                        No se encontraron predios con los criterios seleccionados.
                    </td>
                </tr>`;
            document.getElementById('lblInfoPaginacion').innerText = '0 registros encontrados';
            document.getElementById('paginadorUI').innerHTML = '';
            return;
        }

        const totalPaginas = Math.ceil(totalRegistros / tamanoPagina) || 1;
        if (paginaActual > totalPaginas) paginaActual = totalPaginas;
        if (paginaActual < 1) paginaActual = 1;

        const inicio = (paginaActual - 1) * tamanoPagina;
        const fin = Math.min(inicio + tamanoPagina, totalRegistros);
        const itemsPagina = datosActuales.slice(inicio, fin);

        let html = '';
        for (let i = 0; i < itemsPagina.length; i++) {
            const it = itemsPagina[i];
            const cod = it.codFijo ? `<span class="badge bg-dark font-monospace">${it.codFijo}</span>` : '<span class="text-muted fst-italic">S/C</span>';
            const nom = it.nombre || '-';
            const uv = it.uv || '-';
            const mza = it.mza || '-';
            const lote = it.nroLote || '-';
            const fecha = it.fechaCambioEstado ? it.fechaCambioEstado.substring(0, 10) : '-';

            let badgeEstado = '';
            if (!it.tieneSuministro || it.estado === 0) {
                badgeEstado = '<span class="badge bg-light text-secondary border d-inline-flex align-items-center gap-1"><i class="bi bi-dash-circle"></i> Baldío</span>';
            } else if (it.estado === 1) {
                badgeEstado = '<span class="badge d-inline-flex align-items-center gap-1 text-white" style="background-color: #5E7A4A;"><i class="bi bi-check-circle"></i> Normal</span>';
            } else if (it.estado === 2) {
                badgeEstado = '<span class="badge d-inline-flex align-items-center gap-1 text-white" style="background-color: #C27D38;"><i class="bi bi-exclamation-triangle"></i> Para Corte</span>';
            } else if (it.estado === 3) {
                badgeEstado = '<span class="badge d-inline-flex align-items-center gap-1 text-white" style="background-color: #B84A39;"><i class="bi bi-slash-circle"></i> Cortado</span>';
            } else {
                badgeEstado = `<span class="badge bg-secondary">${it.estadoDesc || 'Baja'}</span>`;
            }

            let botonMapa = '-';
            if (it.latitud && it.longitud) {
                const latStr = Number(it.latitud).toFixed(6);
                const lngStr = Number(it.longitud).toFixed(6);
                const paramDest = it.codFijo ? `cod=${it.codFijo}` : `lote=${encodeURIComponent(it.nroLote || '')}`;
                const btnClase = it.tieneSuministro ? 'btn-olive' : 'btn-sand';
                botonMapa = `<a href="/Mapa?lat=${latStr}&lng=${lngStr}&${paramDest}" class="btn btn-sm ${btnClase} py-0 px-2 d-inline-flex align-items-center gap-1" style="font-size: 0.76rem;" title="Localizar en mapa"><i class="bi bi-geo-alt"></i> Mapa</a>`;
            }

            let botonEstado = '';
            if (it.tieneSuministro && it.codFijo) {
                const nomEscaped = (it.nombre || '').replace(/'/g, "\\'");
                botonEstado = `<button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 d-inline-flex align-items-center gap-1" style="font-size: 0.76rem;" onclick="abrirModalEstado(${it.codFijo}, '${nomEscaped}', ${it.estado})" title="Modificar estado de corte"><i class="bi bi-toggles"></i> Estado</button>`;
            }

            html += `
                <tr>
                    <td class="fw-bold font-monospace" style="color: #2D302B;">${cod}</td>
                    <td class="fw-medium">${nom}</td>
                    <td><span class="badge bg-light text-dark border">${uv}</span></td>
                    <td><span class="badge bg-light text-dark border">${mza}</span></td>
                    <td><span class="badge bg-light text-dark border">${lote}</span></td>
                    <td>${badgeEstado}</td>
                    <td class="small text-muted font-monospace">${fecha}</td>
                    <td class="text-center">
                        <div class="d-inline-flex gap-1">
                            ${botonMapa}
                            ${botonEstado}
                        </div>
                    </td>
                </tr>`;
        }

        tbody.innerHTML = html;
        document.getElementById('lblInfoPaginacion').innerText = 
            `Mostrando registros ${inicio + 1} - ${fin} de ${totalRegistros} predios (Página ${paginaActual} de ${totalPaginas})`;

        renderizarBotonesPaginador(totalPaginas);
    }

    function renderizarBotonesPaginador(totalPaginas) {
        const ul = document.getElementById('paginadorUI');
        if (totalPaginas <= 1) {
            ul.innerHTML = '';
            return;
        }

        let html = '';

        // Botón Anterior
        const deshabAnt = (paginaActual === 1) ? ' disabled' : '';
        html += `<li class="page-item${deshabAnt}"><button class="page-link" onclick="cambiarPagina(${paginaActual - 1})"><i class="bi bi-chevron-left"></i></button></li>`;

        // Rango de páginas visibles (máximo 7 botones)
        let inicioPag = Math.max(1, paginaActual - 3);
        let finPag = Math.min(totalPaginas, inicioPag + 6);
        if (finPag - inicioPag < 6) {
            inicioPag = Math.max(1, finPag - 6);
        }

        if (inicioPag > 1) {
            html += `<li class="page-item"><button class="page-link" onclick="cambiarPagina(1)">1</button></li>`;
            if (inicioPag > 2) {
                html += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }
        }

        for (let p = inicioPag; p <= finPag; p++) {
            const activa = (p === paginaActual) ? ' active' : '';
            html += `<li class="page-item${activa}"><button class="page-link" onclick="cambiarPagina(${p})">${p}</button></li>`;
        }

        if (finPag < totalPaginas) {
            if (finPag < totalPaginas - 1) {
                html += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }
            html += `<li class="page-item"><button class="page-link" onclick="cambiarPagina(${totalPaginas})">${totalPaginas}</button></li>`;
        }

        // Botón Siguiente
        const deshabSig = (paginaActual === totalPaginas) ? ' disabled' : '';
        html += `<li class="page-item${deshabSig}"><button class="page-link" onclick="cambiarPagina(${paginaActual + 1})"><i class="bi bi-chevron-right"></i></button></li>`;

        ul.innerHTML = html;
    }

    function cambiarPagina(nuevaPagina) {
        paginaActual = nuevaPagina;
        renderizarPaginaActual();
        document.getElementById('tablaResultados').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function limpiarFiltros() {
        document.getElementById('filtroTexto').value = '';
        document.getElementById('filtroUV').value = '';
        document.getElementById('filtroLote').value = '';
        document.getElementById('filtroEstado').value = '';
        actualizarComboboxManzanasPorUV('');
        document.getElementById('filtroMZA').value = '';
        cambiarTipoPredio('TODOS');
    }

    // Modal para cambio de estado
    let modalInstance = null;
    function abrirModalEstado(codFijo, titular, estadoActual) {
        document.getElementById('modalCodFijo').value = codFijo;
        document.getElementById('modalTxtCodFijo').innerText = codFijo;
        document.getElementById('modalTxtTitular').innerText = titular;
        document.getElementById('modalSelEstado').value = estadoActual > 0 ? estadoActual : 1;
        document.getElementById('modalTxtMotivo').value = '';
        document.getElementById('modalAlertError').style.display = 'none';

        if (!modalInstance) {
            modalInstance = new bootstrap.Modal(document.getElementById('modalCambioEstado'));
        }
        modalInstance.show();
    }

    function guardarCambioEstado() {
        const codFijo = parseInt(document.getElementById('modalCodFijo').value);
        const nuevoEstado = parseInt(document.getElementById('modalSelEstado').value);
        const motivo = document.getElementById('modalTxtMotivo').value.trim();
        const alertErr = document.getElementById('modalAlertError');
        const btn = document.getElementById('btnGuardarCambioEstado');

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando...';
        alertErr.style.display = 'none';

        fetch('/api/suministros/cambiar-estado', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ codFijo: codFijo, nuevoEstado: nuevoEstado, motivo: motivo })
        })
        .then(res => res.json())
        .then(data => {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-check2-circle"></i> Guardar Estado';
            if (data && data.success) {
                modalInstance.hide();
                // Actualizar elemento en memoria inmediatamente
                const item = datosActuales.find(x => x.codFijo === codFijo);
                if (item) {
                    item.estado = nuevoEstado;
                    item.estadoDesc = data.estadoDesc;
                    item.fechaCambioEstado = new Date().toISOString().substring(0, 10);
                }
                renderizarPaginaActual();
            } else {
                alertErr.innerText = data.mensaje || 'Error al actualizar el estado.';
                alertErr.style.display = 'block';
            }
        })
        .catch(err => {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-check2-circle"></i> Guardar Estado';
            alertErr.innerText = 'Error de conexión con el servidor.';
            alertErr.style.display = 'block';
        });
    }

    // Exportación CSV
    function exportarCSV() {
        if (!datosActuales || datosActuales.length === 0) {
            alert("No hay registros para exportar con los filtros actuales.");
            return;
        }

        let lineas = [];
        lineas.push(["Código Fijo", "Titular", "UV", "Manzana", "Lote", "Estado", "Fecha Último Estado", "Latitud", "Longitud"].map(h => `"${h}"`).join(";"));

        for (let i = 0; i < datosActuales.length; i++) {
            const it = datosActuales[i];
            const cod = it.codFijo || '';
            const nom = (it.nombre || '').replace(/"/g, '""');
            const uv = (it.uv || '').replace(/"/g, '""');
            const mza = (it.mza || '').replace(/"/g, '""');
            const lote = (it.nroLote || '').replace(/"/g, '""');
            const estado = it.estadoDesc || '';
            const fecha = it.fechaCambioEstado ? it.fechaCambioEstado.substring(0, 10) : '';
            const lat = it.latitud ? Number(it.latitud).toFixed(6) : '';
            const lng = it.longitud ? Number(it.longitud).toFixed(6) : '';

            lineas.push([`"${cod}"`, `"${nom}"`, `"${uv}"`, `"${mza}"`, `"${lote}"`, `"${estado}"`, `"${fecha}"`, `"${lat}"`, `"${lng}"`].join(";"));
        }

        const csvContent = "\uFEFF" + lineas.join("\r\n");
        const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.setAttribute("href", url);
        link.setAttribute("download", `predios_exportados_${new Date().toISOString().substring(0, 10)}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }
</script>
}
