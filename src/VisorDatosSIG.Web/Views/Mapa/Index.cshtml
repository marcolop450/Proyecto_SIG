@{
    ViewData["Title"] = "Visor Cartográfico";
}

<div class="row g-2 mb-2 align-items-center">
    <div class="col-md-5">
        <h4 class="m-0" style="font-weight: 700; color: #2C2D2A;">Visor Cartográfico</h4>
    </div>
    <div class="col-md-7">
        <div class="input-group">
            <input type="text" id="txtBusquedaRapida" class="form-control" placeholder="Buscar por código, titular, UV, MZA o lote..." style="background: #FFFFFF; border-color: #C9C5B9;" />
            <button id="btnBuscarRapido" class="btn btn-olive" type="button">Buscar</button>
            <button id="btnResetZoom" class="btn btn-sand" type="button" title="Extensión General">⛶ Extensión</button>
        </div>
    </div>
</div>

<div class="position-relative">
    <!-- Contenedor del Mapa Leaflet -->
    <div id="mapContainer"></div>

    <!-- Panel Flotante de Capas y Leyenda (Izquierda) -->
    <div id="panelCapas" class="position-absolute top-0 start-0 m-3 layer-panel" style="z-index: 1000; width: 250px; font-size: 0.85rem;">
        <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom text-uppercase" style="letter-spacing: 0.5px; color: #4B4E47;">
            <span class="fw-bold">Capas y Filtros</span>
            <button type="button" id="btnTogglePanel" class="btn btn-sm btn-outline-secondary py-0 px-1" style="font-size: 0.75rem;" title="Minimizar panel">▲</button>
        </div>
        
        <div id="panelCapasBody">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="chkManzanas" checked />
                <label class="form-check-label" for="chkManzanas">
                    <span class="legend-badge" style="border: 1.5px solid #5E7A4A; background: rgba(94, 122, 74, 0.1);"></span>
                    Manzanas (863)
                </label>
            </div>
            
            <div class="form-check mb-1">
                <input class="form-check-input" type="checkbox" id="chkLotes" checked />
                <label class="form-check-label" for="chkLotes">
                    <span class="legend-badge" style="border: 1px solid #C89D3C; background: rgba(200, 157, 60, 0.25);"></span>
                    Lotes Catastrales
                </label>
            </div>

            <!-- Control de Opacidad de Lotes para ver fondo -->
            <div class="mb-2 ps-4">
                <div class="d-flex justify-content-between text-muted" style="font-size: 0.72rem;">
                    <span>Opacidad:</span>
                    <span id="lblOpacidadLotes">25%</span>
                </div>
                <input type="range" class="form-range" id="rngOpacidadLotes" min="0" max="100" value="25" style="height: 4px;" />
            </div>
            
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="chkVias" checked />
                <label class="form-check-label" for="chkVias">
                    <span class="legend-badge" style="height: 3px; background: #3B3D38; border-radius: 0;"></span>
                    Red Vial (578)
                </label>
            </div>
            
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="chkCodigosFijos" checked />
                <label class="form-check-label" for="chkCodigosFijos">
                    <span class="legend-badge" style="background: #B84A39; border-radius: 50%;"></span>
                    Códigos Fijos
                </label>
            </div>

            <!-- Filtros por Estado de Suministro -->
            <div class="fw-bold mt-2 mb-1 pt-2 border-top text-uppercase" style="letter-spacing: 0.5px; color: #4B4E47; font-size: 0.78rem;">
                Filtrar Estados de Código
            </div>
            <div class="small ps-1 mb-2">
                <div class="form-check mb-1">
                    <input class="form-check-input filtro-estado" type="checkbox" id="chkEstadoNormal" value="1" checked />
                    <label class="form-check-label" for="chkEstadoNormal">
                        <span class="legend-badge" style="background: #5E7A4A; border-radius: 50%;"></span> Normal (1)
                    </label>
                </div>
                <div class="form-check mb-1">
                    <input class="form-check-input filtro-estado" type="checkbox" id="chkEstadoCorte" value="2" checked />
                    <label class="form-check-label" for="chkEstadoCorte">
                        <span class="legend-badge" style="background: #C27D38; border-radius: 50%;"></span> Para Corte (2)
                    </label>
                </div>
                <div class="form-check mb-1">
                    <input class="form-check-input filtro-estado" type="checkbox" id="chkEstadoCortado" value="3" checked />
                    <label class="form-check-label" for="chkEstadoCortado">
                        <span class="legend-badge" style="background: #B84A39; border-radius: 50%;"></span> Cortado (3)
                    </label>
                </div>
            </div>

            <div class="fw-bold mt-2 mb-1 pt-2 border-top text-uppercase" style="letter-spacing: 0.5px; color: #4B4E47; font-size: 0.78rem;">
                Mapa Base
            </div>
            <select id="selMapaBase" class="form-select form-select-sm" style="background: #FAF9F5; border-color: #C9C5B9; font-size: 0.8rem;">
                <option value="osm">OpenStreetMap Estándar</option>
                <option value="topo">OpenTopoMap (Relieve)</option>
                <option value="esri">Esri Satelital HD</option>
            </select>
        </div>
    </div>

    <!-- Panel Inspector de Entidad Seleccionada (Derecha) -->
    <div id="inspectorPanel" class="position-absolute top-0 end-0 m-3 p-3 shadow-md" style="z-index: 1000; width: 310px; background: rgba(255, 255, 255, 0.97); border: 1px solid #C9C5B9; border-radius: 4px; display: none;">
        <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom">
            <strong id="inspectorTitle" style="color: #2D302B;">Ficha Técnica</strong>
            <button type="button" class="btn-close btn-sm" onclick="cerrarInspector()"></button>
        </div>
        <div id="inspectorContent" style="font-size: 0.85rem; max-height: 380px; overflow-y: auto;">
        </div>
    </div>

    <!-- Barra inferior de Coordenadas y Escala -->
    <div class="position-absolute bottom-0 end-0 m-2 px-2 py-1 bg-white border rounded shadow-sm small text-muted" style="z-index: 1000; font-family: monospace;">
        Coord: <span id="lblCoords">-16.377, -60.963</span> | Zoom: <span id="lblZoom">14</span> | WGS 84 (SRID 4326)
    </div>
</div>

@section Scripts {
<script>
    let map;
    let baseLayers = {};
    let currentBaseLayer;
    let layerManzanas, layerLotes, layerVias, layerCodigosFijos;
    let rawCodigosFijosData = null;
    let initialBounds = L.latLngBounds([[-16.440, -61.007], [-16.321, -60.919]]);
    let highlightLayer;

    document.addEventListener("DOMContentLoaded", function () {
        initMap();
        cargarCapas();
        setupEvents();
        verificarParametrosURL();
    });

    function initMap() {
        map = L.map('mapContainer', {
            zoomControl: false,
            center: [-16.377, -60.963],
            zoom: 14,
            minZoom: 5,   // Permite alejar hasta ver todo el departamento (+5 niveles)
            maxZoom: 22   // Precisión métrica
        });

        // Zoom en esquina superior derecha para evitar solapar con las capas
        L.control.zoom({ position: 'topright' }).addTo(map);

        map.createPane('paneManzanas');
        map.getPane('paneManzanas').style.zIndex = 400;

        map.createPane('paneLotes');
        map.getPane('paneLotes').style.zIndex = 450;

        map.createPane('paneVias');
        map.getPane('paneVias').style.zIndex = 500;

        map.createPane('paneCodigosFijos');
        map.getPane('paneCodigosFijos').style.zIndex = 600;

        baseLayers.osm = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap',
            maxZoom: 22
        });

        baseLayers.topo = L.tileLayer('https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenTopoMap',
            maxZoom: 17
        });

        baseLayers.esri = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
            attribution: 'Tiles &copy; Esri &mdash; Satélite',
            maxZoom: 20
        });

        currentBaseLayer = baseLayers.osm;
        currentBaseLayer.addTo(map);

        L.control.scale({ metric: true, imperial: false, position: 'bottomleft' }).addTo(map);

        map.on('mousemove', function (e) {
            document.getElementById('lblCoords').innerText = 
                `Lat: ${e.latlng.lat.toFixed(5)}, Lon: ${e.latlng.lng.toFixed(5)}`;
        });

        map.on('zoomend', function () {
            document.getElementById('lblZoom').innerText = map.getZoom();
        });
    }

    function cargarCapas() {
        // 1. Manzanas
        fetch('/api/capas/manzanas')
            .then(res => res.json())
            .then(data => {
                layerManzanas = L.geoJSON(data, {
                    pane: 'paneManzanas',
                    style: {
                        color: "#5E7A4A",
                        weight: 1.5,
                        dashArray: "4, 4",
                        fillColor: "#5E7A4A",
                        fillOpacity: 0.04
                    },
                    onEachFeature: function (f, l) {
                        l.on('click', () => mostrarInspector("Manzana", f.properties));
                    }
                }).addTo(map);
            });

        // 2. Lotes
        fetch('/api/capas/lotes?limit=5000')
            .then(res => res.json())
            .then(data => {
                layerLotes = L.geoJSON(data, {
                    pane: 'paneLotes',
                    style: {
                        color: "#C29845",
                        weight: 1,
                        fillColor: "#F5E9CE",
                        fillOpacity: 0.25
                    },
                    onEachFeature: function (f, l) {
                        l.on('click', () => mostrarInspector("Lote Catastral", f.properties));
                    }
                }).addTo(map);
            });

        // 3. Vías
        fetch('/api/capas/vias')
            .then(res => res.json())
            .then(data => {
                layerVias = L.geoJSON(data, {
                    pane: 'paneVias',
                    style: {
                        color: "#3B3D38",
                        weight: 2.2,
                        opacity: 0.85
                    },
                    onEachFeature: function (f, l) {
                        l.on('click', () => mostrarInspector("Vía", f.properties));
                    }
                }).addTo(map);
            });

        // 4. Códigos Fijos con filtrado dinámico
        fetch('/api/capas/codigosfijos?limit=6500')
            .then(res => res.json())
            .then(data => {
                rawCodigosFijosData = data;
                renderizarCodigosFijos();
            });
    }

    function renderizarCodigosFijos() {
        if (!rawCodigosFijosData) return;
        if (layerCodigosFijos) map.removeLayer(layerCodigosFijos);

        let estadosActivos = [];
        document.querySelectorAll('.filtro-estado:checked').forEach(cb => {
            estadosActivos.push(parseInt(cb.value));
        });

        layerCodigosFijos = L.geoJSON(rawCodigosFijosData, {
            pane: 'paneCodigosFijos',
            filter: function (f) {
                return estadosActivos.includes(f.properties.estado);
            },
            pointToLayer: function (feature, latlng) {
                let color = '#5E7A4A';
                if (feature.properties.estado == 2) color = '#C27D38';
                if (feature.properties.estado == 3) color = '#B84A39';

                return L.circleMarker(latlng, {
                    radius: 3.5,
                    fillColor: color,
                    color: '#FFFFFF',
                    weight: 1,
                    opacity: 1,
                    fillOpacity: 0.95
                });
            },
            onEachFeature: function (f, l) {
                l.on('click', () => mostrarInspector("Código Fijo (Medidor)", f.properties));
            }
        });

        if (document.getElementById('chkCodigosFijos').checked) {
            layerCodigosFijos.addTo(map);
        }
    }

    function setupEvents() {
        document.getElementById('chkManzanas').addEventListener('change', function () {
            if (this.checked) map.addLayer(layerManzanas); else map.removeLayer(layerManzanas);
        });

        document.getElementById('chkLotes').addEventListener('change', function () {
            if (this.checked) map.addLayer(layerLotes); else map.removeLayer(layerLotes);
        });

        document.getElementById('chkVias').addEventListener('change', function () {
            if (this.checked) map.addLayer(layerVias); else map.removeLayer(layerVias);
        });

        document.getElementById('chkCodigosFijos').addEventListener('change', function () {
            if (this.checked) map.addLayer(layerCodigosFijos); else map.removeLayer(layerCodigosFijos);
        });

        document.querySelectorAll('.filtro-estado').forEach(cb => {
            cb.addEventListener('change', renderizarCodigosFijos);
        });

        // Opacidad de lotes interactiva
        document.getElementById('rngOpacidadLotes').addEventListener('input', function () {
            let val = parseInt(this.value) / 100;
            document.getElementById('lblOpacidadLotes').innerText = this.value + '%';
            if (layerLotes) {
                layerLotes.setStyle({ fillOpacity: val });
            }
        });

        document.getElementById('selMapaBase').addEventListener('change', function () {
            map.removeLayer(currentBaseLayer);
            currentBaseLayer = baseLayers[this.value];
            currentBaseLayer.addTo(map);
        });

        document.getElementById('btnResetZoom').addEventListener('click', function () {
            map.fitBounds(initialBounds);
        });

        document.getElementById('btnBuscarRapido').addEventListener('click', ejecutarBusquedaRapida);
        document.getElementById('txtBusquedaRapida').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') ejecutarBusquedaRapida();
        });

        document.getElementById('btnTogglePanel').addEventListener('click', function () {
            let body = document.getElementById('panelCapasBody');
            if (body.style.display === 'none') {
                body.style.display = 'block';
                this.innerText = '▲';
            } else {
                body.style.display = 'none';
                this.innerText = '▼';
            }
        });
    }

    function verificarParametrosURL() {
        let params = new URLSearchParams(window.location.search);
        let lat = parseFloat(params.get('lat'));
        let lng = parseFloat(params.get('lng'));
        let cod = params.get('cod');

        if (!isNaN(lat) && !isNaN(lng)) {
            setTimeout(() => {
                map.setView([lat, lng], 18);
                if (highlightLayer) map.removeLayer(highlightLayer);
                highlightLayer = L.circleMarker([lat, lng], {
                    radius: 12,
                    fillColor: "#C89D3C",
                    color: "#FFFFFF",
                    weight: 3,
                    fillOpacity: 0.8
                }).addTo(map);

                if (cod) {
                    mostrarInspector("Inmueble Seleccionado", { "CodFijo": cod, "Latitud": lat, "Longitud": lng });
                }
            }, 600);
        }
    }

    function ejecutarBusquedaRapida() {
        let texto = document.getElementById('txtBusquedaRapida').value.trim();
        if (!texto) return;

        fetch(`/api/busqueda?texto=${encodeURIComponent(texto)}`)
            .then(res => res.json())
            .then(data => {
                if (data && data.length > 0) {
                    let item = data[0];
                    if (item.latitud && item.longitud) {
                        map.setView([item.latitud, item.longitud], 18);

                        if (highlightLayer) map.removeLayer(highlightLayer);
                        highlightLayer = L.circleMarker([item.latitud, item.longitud], {
                            radius: 12,
                            fillColor: "#C89D3C",
                            color: "#FFFFFF",
                            weight: 3,
                            fillOpacity: 0.8
                        }).addTo(map);

                        mostrarInspector("Resultado de Búsqueda", item);
                    }
                } else {
                    alert("No se encontraron registros con el término especificado.");
                }
            });
    }

    function mostrarInspector(tipo, props) {
        document.getElementById('inspectorTitle').innerText = tipo;
        let html = '<table class="table table-sm table-borderless m-0">';
        for (let k in props) {
            if (k === 'wkt' || k === 'id') continue;
            let val = props[k] !== null && props[k] !== undefined ? props[k] : '<span class="text-muted">-</span>';
            html += `<tr><td class="text-muted text-uppercase" style="font-size:0.75rem; width:45%;">${k}:</td><td><strong>${val}</strong></td></tr>`;
        }
        html += '</table>';
        document.getElementById('inspectorContent').innerHTML = html;
        document.getElementById('inspectorPanel').style.display = 'block';
    }

    function cerrarInspector() {
        document.getElementById('inspectorPanel').style.display = 'none';
    }
</script>
}
