@{
    ViewData["Title"] = "Visor Cartográfico";
    var listaMza = ViewBag.ListaMZA as List<string> ?? new List<string>();
    var listaLotes = ViewBag.ListaLotes as List<string> ?? new List<string>();
    var listaUv = ViewBag.ListaUV as List<string> ?? new List<string>();
}

<div class="d-flex w-100 h-100 position-relative" style="overflow: hidden;">
    <!-- Panel Lateral Izquierdo de Filtros, Capas y Resultados (Estilo Oficial) -->
    <aside id="mapSidebar">
        <!-- Sección 1: Filtros de Búsqueda -->
        <div class="p-3 border-bottom" style="background: #FAFAFA;">
            <!-- Selector Manzanas -->
            <div class="mb-2">
                <label for="selFiltroMza" class="form-label small fw-bold text-muted mb-1">Manzanas</label>
                <select id="selFiltroMza" class="form-select form-select-sm" style="background: #FFFFFF; border-color: #CBD5E1;">
                    <option value="">Todas las Manzanas</option>
                    @foreach (var mza in listaMza)
                    {
                        <option value="@mza">@mza</option>
                    }
                </select>
            </div>

            <!-- Selector Lote -->
            <div class="mb-2">
                <label for="selFiltroLote" class="form-label small fw-bold text-muted mb-1">Lote</label>
                <input type="text" id="selFiltroLote" list="dlLotesMapa" class="form-control form-control-sm" placeholder="Todos los Lotes" style="background: #FFFFFF; border-color: #CBD5E1;" autocomplete="off" />
                <datalist id="dlLotesMapa">
                    <option value="">Todos los Lotes</option>
                    @foreach (var lote in listaLotes)
                    {
                        <option value="@lote">@lote</option>
                    }
                </datalist>
            </div>

            <!-- Buscador Rápido de Código o Titular -->
            <div class="mb-2">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0" style="border-color: #CBD5E1;">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" id="txtBusquedaPredio" class="form-control border-start-0" placeholder="Buscar por código, titular o lote..." style="border-color: #CBD5E1;" />
                </div>
            </div>

            <!-- Botones de Acción de Filtro -->
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-primary btn-sm flex-grow-1 d-flex align-items-center justify-content-center gap-1" onclick="ejecutarFiltroLateral()">
                    <i class="bi bi-funnel-fill"></i>
                    Aplicar Filtro
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="resetearFiltrosLaterales()" title="Restablecer filtros">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </button>
            </div>
        </div>

        <!-- Sección 2: Capas del Mapa -->
        <div class="p-3 border-bottom">
            <div class="fw-bold small text-muted text-uppercase mb-2" style="letter-spacing: 0.5px;">
                <i class="bi bi-layers me-1 text-primary"></i> Capas del Mapa
            </div>

            <div class="mb-3">
                <label for="selMapaBase" class="form-label small text-muted mb-1">Mapa Base</label>
                <select id="selMapaBase" class="form-select form-select-sm" style="background: #FAF9F5; border-color: #CBD5E1;">
                    <option value="topo" selected>OpenTopoMap</option>
                    <option value="osm">OpenStreetMap</option>
                    <option value="esri">Esri Satelital HD</option>
                </select>
            </div>

            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="chkCodigosFijos" checked />
                <label class="form-check-label small" for="chkCodigosFijos">
                    <span class="badge-dot" style="background: #2563EB;"></span> Códigos Fijos
                </label>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="chkManzanas" checked />
                <label class="form-check-label small" for="chkManzanas">
                    <span class="badge-dot" style="background: #10B981;"></span> Manzanas
                </label>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="chkLotes" checked />
                <label class="form-check-label small" for="chkLotes">
                    <span class="badge-dot" style="background: #F59E0B;"></span> Lotes
                </label>
            </div>
            <div class="form-check mb-1">
                <input class="form-check-input" type="checkbox" id="chkVias" checked />
                <label class="form-check-label small" for="chkVias">
                    <span class="badge-dot" style="background: #64748B;"></span> Vías / Calles
                </label>
            </div>
        </div>

        <!-- Sección 3: Simbología de Estados -->
        <div class="p-3 border-bottom" style="background: #FAFAFA;">
            <div class="fw-bold small text-muted text-uppercase mb-2" style="letter-spacing: 0.5px;">
                <i class="bi bi-palette me-1 text-primary"></i> Simbología de Estados
            </div>
            <div class="small ps-1" style="font-size: 0.82rem; line-height: 1.6;">
                <div><span class="badge-dot" style="background: #10B981;"></span> <strong>1 - Normal:</strong> Servicio regular</div>
                <div><span class="badge-dot" style="background: #F59E0B;"></span> <strong>2 - Para corte:</strong> Mora o pendiente</div>
                <div><span class="badge-dot" style="background: #EF4444;"></span> <strong>3 - Cortado:</strong> Suspendido</div>
                <div><span class="badge-dot" style="background: #8B5CF6;"></span> <strong>4 - Baja parcial:</strong> En retiro</div>
                <div><span class="badge-dot" style="background: #64748B;"></span> <strong>5 - Baja total:</strong> Desactivado</div>
            </div>
        </div>

        <!-- Sección 4: Lista de Resultados Encontrados (Screenshot 2) -->
        <div class="p-3 flex-grow-1 d-flex flex-column" style="min-height: 250px;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-bold small text-muted" id="lblCantResultados">Cargando registros...</span>
                <a href="javascript:void(0)" onclick="limpiarListaResultados()" class="small text-primary text-decoration-none fw-semibold">Limpiar</a>
            </div>
            <div id="listaCardsResultados" class="results-cards-container flex-grow-1">
                <!-- Se inyectan las tarjetas dinámicas de predios -->
            </div>
        </div>
    </aside>

    <!-- Contenedor del Mapa Leaflet a Pantalla Completa -->
    <div id="mapContainerFull">
        <!-- Mapa Leaflet -->
        <div id="mapContainer" style="width: 100%; height: 100%;"></div>

        <!-- Botón Flotante para abrir Filtros/Capas en pantallas móviles (< 768px) -->
        <button type="button" id="btnToggleSidebarMobile" class="btn btn-sm shadow d-md-none btn-sig-chiquitano position-absolute" style="top: 12px; left: 50px; z-index: 1005;" onclick="toggleMapSidebarMobile()" aria-label="Abrir panel de filtros y capas">
            <i class="bi bi-sliders me-1"></i> Filtros y Capas
        </button>

        <!-- Fondo Oscuro para cerrar drawer en móvil -->
        <div id="mapSidebarBackdrop" class="position-absolute w-100 h-100 bg-dark bg-opacity-50 d-none" style="top: 0; left: 0; z-index: 1040;" onclick="toggleMapSidebarMobile()"></div>

        <!-- Botón de Extensión General (Posicionado para no colisionar con zoom Leaflet ni Ficha) -->
        <button type="button" id="btnZoomGeneral" class="btn btn-sm shadow-sm d-flex align-items-center gap-1 border position-absolute map-zoom-general-btn" style="top: 12px; z-index: 1005; background: #FFFFFF; font-size: 0.82rem; font-weight: 600; color: #1E293B;" onclick="restablecerExtensionGeneral()" title="Restablecer extensión general">
            <i class="bi bi-arrows-fullscreen"></i>
            <span class="d-none d-sm-inline">Extensión General</span>
        </button>

        <!-- Barra Inferior de Coordenadas y Escala -->
        <div class="position-absolute bottom-0 start-0 m-2 px-2 py-1 bg-white border rounded shadow-sm small text-muted" style="z-index: 1000; font-family: monospace; font-size: 0.76rem;">
            Coord: <span id="lblCoords">-16.377, -60.963</span> | Zoom: <span id="lblZoom">14</span> | WGS 84 (SRID 4326)
        </div>

        <!-- Panel Ficha Catastral Flotante / Bottom Sheet Móvil -->
        <div id="fichaCatastralPanel" class="ficha-catastral-panel" style="display: none;">
            <div class="ficha-header">
                <span class="d-flex align-items-center gap-2">
                    <i class="bi bi-card-heading"></i> Ficha Catastral
                </span>
                <button type="button" class="btn-close btn-close-white btn-sm" onclick="cerrarFicha()" aria-label="Cerrar ficha catastral"></button>
            </div>
            <div class="p-3">
                <!-- Badge de Estado con alto contraste WCAG AA -->
                <div class="text-center mb-2">
                    <span id="fichaBadgeEstado" class="badge px-3 py-2 fw-bold" style="background-color: #D1FAE5; color: #065F46; border: 1px solid #A7F3D0; font-size: 0.85rem; border-radius: 16px;">
                        <i class="bi bi-tag-fill me-1"></i> Estado 1: Normal
                    </span>
                </div>

                <!-- Nombre del Titular e ID -->
                <h5 class="fw-bold text-center text-dark mb-0 text-uppercase" id="fichaNombre" style="letter-spacing: 0.5px; font-size: 1.05rem;">TITULAR DEL PREDIO</h5>
                <div class="text-center text-muted small mb-3" id="fichaIdSistema">ID Sistema: -</div>

                <!-- Tabla de Ficha Catastral -->
                <table class="table table-sm table-bordered m-0" style="font-size: 0.84rem;">
                    <tbody>
                        <tr>
                            <td class="text-muted fw-semibold" style="width: 44%;">Código Fijo:</td>
                            <td class="fw-bold font-monospace text-dark" id="fichaCodFijo">-</td>
                        </tr>
                        <tr>
                            <td class="text-muted fw-semibold">Código SIG:</td>
                            <td class="fw-bold font-monospace" style="color: #854D0E;" id="fichaCodSIG">-</td>
                        </tr>
                        <tr>
                            <td class="text-muted fw-semibold">Unidad Vecinal:</td>
                            <td id="fichaUV">-</td>
                        </tr>
                        <tr>
                            <td class="text-muted fw-semibold">Manzana:</td>
                            <td id="fichaMza">-</td>
                        </tr>
                        <tr>
                            <td class="text-muted fw-semibold">Lote:</td>
                            <td id="fichaLote">-</td>
                        </tr>
                        <tr>
                            <td class="text-muted fw-semibold">Latitud:</td>
                            <td class="font-monospace" id="fichaLat">-</td>
                        </tr>
                        <tr>
                            <td class="text-muted fw-semibold">Longitud:</td>
                            <td class="font-monospace" id="fichaLon">-</td>
                        </tr>
                        <tr>
                            <td class="text-muted fw-semibold">Último Cambio:</td>
                            <td id="fichaFecha">-</td>
                        </tr>
                    </tbody>
                </table>

                <!-- Botones de Acción de la Ficha -->
                <div class="d-flex gap-2 mt-3">
                    <button type="button" class="btn btn-outline-primary btn-sm flex-fill d-flex align-items-center justify-content-center gap-1" onclick="copiarCoordenadasFicha()">
                        <i class="bi bi-clipboard"></i>
                        Copiar Coordenadas
                    </button>
                    <a href="#" id="btnFichaVerConsultas" class="btn btn-primary btn-sm flex-fill d-flex align-items-center justify-content-center gap-1">
                        <i class="bi bi-table"></i>
                        Ver en Consultas
                    </a>
                </div>

                <div class="mt-2 text-center" id="boxModificarEstadoFicha">
                    <button type="button" class="btn btn-sm btn-outline-secondary w-100 py-1" style="font-size: 0.78rem;" onclick="abrirModalModificarDesdeFicha()">
                        <i class="bi bi-toggles me-1"></i> Modificar Estado de Suministro
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Cambio de Estado de Suministro desde el Mapa -->
<div class="modal fade" id="modalMapaCambioEstado" tabindex="-1" aria-hidden="true" style="z-index: 1100;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border: 1px solid #CBD5E1;">
            <div class="modal-header py-2 px-3" style="background: #F8FAFC; border-bottom: 1px solid #E2E8F0;">
                <h6 class="modal-title fw-bold" style="color: #1E293B;">
                    <i class="bi bi-toggles me-1 text-primary"></i>
                    Modificar Estado de Suministro
                </h6>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <input type="hidden" id="mapaModalCodFijo" />
                <div class="mb-2">
                    <span class="text-muted small">Código Fijo:</span>
                    <strong id="mapaModalTxtCodFijo" class="font-monospace ms-1">-</strong>
                </div>
                <div class="mb-3">
                    <span class="text-muted small">Titular:</span>
                    <strong id="mapaModalTxtTitular" class="ms-1">-</strong>
                </div>
                <div class="mb-3">
                    <label for="mapaModalSelEstado" class="form-label small fw-bold text-muted mb-1">
                        Nuevo Estado Operativo
                    </label>
                    <select id="mapaModalSelEstado" class="form-select form-select-sm">
                        <option value="1">1 - Normal (Servicio regular)</option>
                        <option value="2">2 - Para corte (Mora o pendiente)</option>
                        <option value="3">3 - Cortado (Suspendido)</option>
                        <option value="4">4 - Baja parcial (En retiro)</option>
                        <option value="5">5 - Baja total (Desactivado)</option>
                    </select>
                </div>
                <div class="mb-2">
                    <label for="mapaModalTxtMotivo" class="form-label small fw-bold text-muted mb-1">
                        Motivo / Observación
                    </label>
                    <textarea id="mapaModalTxtMotivo" class="form-control form-control-sm" rows="2" placeholder="Ej. Notificación en mora cumplida o pago registrado..."></textarea>
                </div>
                <div id="mapaModalAlertError" class="alert alert-danger py-1 px-2 small mb-0" style="display: none;"></div>
            </div>
            <div class="modal-footer py-2 px-3" style="background: #F8FAFC; border-top: 1px solid #E2E8F0;">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-sm btn-primary d-flex align-items-center gap-1" id="btnMapaGuardarEstado" onclick="guardarEstadoDesdeMapa()">
                    <i class="bi bi-check2-circle"></i>
                    Guardar Estado
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let map;
    let baseLayers = {};
    let currentBaseLayer;
    let layerManzanas, layerLotes, layerVias, layerCodigosFijos;
    let rawCodigosFijos = [];
    let initialBounds = L.latLngBounds([[-16.440, -61.007], [-16.321, -60.919]]);
    let highlightCircleMarker = null;
    let modalMapaInstance = null;
    let currentSelectedItem = null;

    document.addEventListener("DOMContentLoaded", function () {
        initMap();
        cargarCapas();
        setupSidebarEvents();
        verificarParametrosURL();
    });

    function initMap() {
        map = L.map('mapContainer', {
            preferCanvas: true,
            zoomControl: false,
            center: [-16.377, -60.963],
            zoom: 14,
            minZoom: 5,
            maxZoom: 22
        });

        // Controles de Zoom en esquina superior izquierda
        L.control.zoom({ position: 'topleft' }).addTo(map);

        // Capas en panes con z-index
        map.createPane('paneManzanas');
        map.getPane('paneManzanas').style.zIndex = 400;

        map.createPane('paneLotes');
        map.getPane('paneLotes').style.zIndex = 450;

        map.createPane('paneVias');
        map.getPane('paneVias').style.zIndex = 500;

        map.createPane('paneCodigosFijos');
        map.getPane('paneCodigosFijos').style.zIndex = 550;

        // Mapas Base
        baseLayers.osm = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap'
        });

        baseLayers.topo = L.tileLayer('https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png', {
            attribution: 'Map data: &copy; OpenStreetMap, SRTM | Map style: &copy; OpenTopoMap'
        });

        baseLayers.esri = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
            attribution: 'Tiles &copy; Esri World Imagery'
        });

        // OpenTopoMap por defecto tal como en la captura
        currentBaseLayer = baseLayers.topo;
        currentBaseLayer.addTo(map);

        map.on('mousemove', function (e) {
            document.getElementById('lblCoords').innerText = e.latlng.lat.toFixed(6) + ', ' + e.latlng.lng.toFixed(6);
        });

        map.on('zoomend', function () {
            document.getElementById('lblZoom').innerText = map.getZoom();
        });
    }

    function cargarCapas() {
        // 1. Manzanas
        fetch('/api/capas/manzanas')
            .then(res => res.json())
            .then(data => {
                layerManzanas = L.geoJSON(data, {
                    pane: 'paneManzanas',
                    style: {
                        color: "#10B981",
                        weight: 1.5,
                        fillColor: "#10B981",
                        fillOpacity: 0.08
                    },
                    onEachFeature: function (f, l) {
                        l.on('click', () => {
                            mostrarFichaDesdePropiedades({
                                nombre: "MANZANA " + (f.properties.MZA || f.properties.UV_MZA || ""),
                                idSistema: "MZ-" + (f.properties.IdManzana || ""),
                                codFijo: "-",
                                codSIG: f.properties.UV_MZA || "-",
                                uv: f.properties.UV || "-",
                                mza: f.properties.MZA || "-",
                                lote: "-",
                                estado: 1,
                                latitud: f.properties.Latitud || -16.377,
                                longitud: f.properties.Longitud || -60.963
                            });
                        });
                    }
                }).addTo(map);
            }).catch(e => console.warn("Error cargando manzanas:", e));

        // 2. Lotes
        fetch('/api/capas/lotes?limit=15300')
            .then(res => res.json())
            .then(data => {
                layerLotes = L.geoJSON(data, {
                    pane: 'paneLotes',
                    style: {
                        color: "#B88B2A",
                        weight: 1,
                        fillColor: "#C89D3C",
                        fillOpacity: 0.18
                    },
                    onEachFeature: function (f, l) {
                        l.on('click', () => {
                            mostrarFichaDesdePropiedades({
                                nombre: "LOTE CATASTRAL " + (f.properties.NroLote || ""),
                                idSistema: "LT-" + (f.properties.IdLote || ""),
                                codFijo: "-",
                                codSIG: f.properties.NroLote || "-",
                                uv: f.properties.UV || "-",
                                mza: f.properties.MZA || "-",
                                lote: f.properties.NroLote || "-",
                                estado: 1,
                                latitud: f.properties.Latitud || -16.377,
                                longitud: f.properties.Longitud || -60.963
                            });
                        });
                    }
                }).addTo(map);
            }).catch(e => console.warn("Error cargando lotes:", e));

        // 3. Vías
        fetch('/api/capas/vias')
            .then(res => res.json())
            .then(data => {
                layerVias = L.geoJSON(data, {
                    pane: 'paneVias',
                    style: {
                        color: "#475569",
                        weight: 2,
                        opacity: 0.85
                    }
                }).addTo(map);
            }).catch(e => console.warn("Error cargando vías:", e));

        // 4. Códigos Fijos (6,271 puntos)
        fetch('/api/capas/codigosfijos?limit=6500')
            .then(res => res.json())
            .then(data => {
                rawCodigosFijos = (data.features || []).map(f => {
                    const p = f.properties || {};
                    const coords = f.geometry?.coordinates || [0, 0];
                    return {
                        idCodigo: p.IdCodigo,
                        codFijo: p.CodFijo,
                        codSIG: p.CodF_SIG || (p.UV && p.MZA && p.Lote ? `${p.UV}.${p.MZA}.${p.Lote}` : "-"),
                        nombre: (p.Nombre || "SIN TITULAR REGISTRADO").trim(),
                        uv: p.UV || "-",
                        mza: p.MZA || "-",
                        lote: p.Lote || "-",
                        estado: p.Estado || 1,
                        latitud: p.Latitud || coords[1],
                        longitud: p.Longitud || coords[0],
                        fechaEstado: p.FechaEstado ? new Date(p.FechaEstado).toLocaleDateString('es-ES') : "22/9/2026"
                    };
                });

                rawCodigosFijos.sort((a, b) => (parseInt(a.codFijo) || 999999) - (parseInt(b.codFijo) || 999999));

                renderizarCapaCodigosFijos(rawCodigosFijos);
                renderizarListaCards(rawCodigosFijos);
            }).catch(e => console.error("Error cargando códigos fijos:", e));
    }

    function renderizarCapaCodigosFijos(items) {
        if (layerCodigosFijos && map.hasLayer(layerCodigosFijos)) {
            map.removeLayer(layerCodigosFijos);
        }

        const markers = [];
        items.forEach(item => {
            if (!item.latitud || !item.longitud) return;

            const color = obtenerColorEstado(item.estado);
            const m = L.circleMarker([item.latitud, item.longitud], {
                pane: 'paneCodigosFijos',
                radius: 4.5,
                fillColor: color,
                color: '#FFFFFF',
                weight: 1.2,
                opacity: 1,
                fillOpacity: 0.95
            });

            m.on('click', () => {
                seleccionarPredioEnMapa(item);
            });

            markers.push(m);
        });

        layerCodigosFijos = L.featureGroup(markers);
        if (document.getElementById('chkCodigosFijos').checked) {
            layerCodigosFijos.addTo(map);
        }
    }

    function obtenerColorEstado(estado) {
        switch (estado) {
            case 1: return "#0D8258"; // Normal (Verde accesible WCAG AA)
            case 2: return "#D97706"; // Para Corte (Ámbar oscuro accesible WCAG AA)
            case 3: return "#DC2626"; // Cortado (Rojo accesible WCAG AA)
            case 4: return "#7C3AED"; // Baja Parcial
            case 5: return "#475569"; // Baja Total
            default: return "#0D8258";
        }
    }

    function obtenerDescEstado(estado) {
        switch (estado) {
            case 1: return "Normal";
            case 2: return "Para corte";
            case 3: return "Cortado";
            case 4: return "Baja parcial";
            case 5: return "Baja total";
            default: return "Normal";
        }
    }

    let cardsDataMap = {};

    function renderizarListaCards(items) {
        const contenedor = document.getElementById('listaCardsResultados');
        const contador = document.getElementById('lblCantResultados');
        
        contador.innerText = `${items.length.toLocaleString()} registros encontrados`;

        if (items.length === 0) {
            contenedor.innerHTML = '<div class="text-center text-muted py-4 small">No se encontraron predios con los filtros indicados.</div>';
            return;
        }

        // Renderizar los primeros 150 registros para velocidad óptima de DOM
        const displayItems = items.slice(0, 150);
        let html = '';
        cardsDataMap = {};

        displayItems.forEach(item => {
            const itemKey = String(item.idCodigo || item.codFijo);
            cardsDataMap[itemKey] = item;

            const color = obtenerColorEstado(item.estado);
            const desc = obtenerDescEstado(item.estado);
            let badgeStyle = '';
            if (item.estado === 1) {
                badgeStyle = 'background-color: #D1FAE5; color: #065F46; border: 1px solid #A7F3D0;';
            } else if (item.estado === 2) {
                badgeStyle = 'background-color: #FEF3C7; color: #78350F; border: 1px solid #FDE68A;';
            } else if (item.estado === 3) {
                badgeStyle = 'background-color: #FEE2E2; color: #991B1B; border: 1px solid #FECACA;';
            } else {
                badgeStyle = 'background-color: #E2E8F0; color: #475569; border: 1px solid #CBD5E1;';
            }

            html += `
            <div class="result-card-item" tabindex="0" role="button" aria-label="Predio ${item.nombre}, Código ${item.codFijo || item.idCodigo}" onclick="seleccionarPredioPorKey('${itemKey}')" onkeydown="handleCardKey(event, '${itemKey}')" id="card-predio-${itemKey}">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-bold font-monospace" style="color: ${color}; font-size: 0.8rem;">COD. ${item.codFijo || item.idCodigo}</span>
                    <span class="badge fw-bold" style="${badgeStyle} font-size: 0.68rem; padding: 2px 6px;">${desc}</span>
                </div>
                <div class="fw-bold text-dark text-truncate" style="font-size: 0.82rem;" title="${item.nombre}">
                    ${item.nombre}
                </div>
                <div class="small text-muted d-flex align-items-center gap-1 mt-1" style="font-size: 0.74rem;">
                    <i class="bi bi-geo-alt"></i> UV ${item.uv} - Mz ${item.mza} - Lote ${item.lote}
                </div>
            </div>`;
        });

        if (items.length > 150) {
            html += `<div class="text-center py-2 text-muted small" style="font-size: 0.75rem;">Mostrando 150 de ${items.length.toLocaleString()} registros. Afine los filtros para ver más.</div>`;
        }

        contenedor.innerHTML = html;
    }

    function seleccionarPredioPorKey(key) {
        const item = cardsDataMap[key];
        if (item) {
            seleccionarPredioEnMapa(item);
        }
    }

    function handleCardKey(event, key) {
        if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            seleccionarPredioPorKey(key);
        }
    }

    function seleccionarPredioDesdeCard(item) {
        seleccionarPredioEnMapa(item);
    }

    function seleccionarPredioEnMapa(item) {
        currentSelectedItem = item;

        // Resaltar tarjeta seleccionada en la barra lateral
        document.querySelectorAll('.result-card-item').forEach(c => c.classList.remove('selected'));
        const activeCard = document.getElementById(`card-predio-${item.idCodigo || item.codFijo}`);
        if (activeCard) {
            activeCard.classList.add('selected');
            activeCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        // Animar y volar a las coordenadas en el mapa
        if (item.latitud && item.longitud) {
            map.flyTo([item.latitud, item.longitud], 18, { duration: 1.2 });

            // Dibujar el círculo de selección punteado animado (Screenshot 1)
            if (highlightCircleMarker) {
                map.removeLayer(highlightCircleMarker);
            }

            const iconPulse = L.divIcon({
                className: 'pulse-selection-circle',
                iconSize: [44, 44],
                iconAnchor: [22, 22]
            });

            highlightCircleMarker = L.marker([item.latitud, item.longitud], { icon: iconPulse, zIndexOffset: 1000 }).addTo(map);
        }

        // Si estamos en móvil, cerramos el drawer de sidebar al seleccionar para ver el mapa y la ficha
        if (window.innerWidth < 768) {
            const sidebar = document.getElementById('mapSidebar');
            const backdrop = document.getElementById('mapSidebarBackdrop');
            if (sidebar && sidebar.classList.contains('sidebar-open')) {
                sidebar.classList.remove('sidebar-open');
                if (backdrop) backdrop.classList.add('d-none');
            }
        }

        // Mostrar Ficha Catastral a la derecha
        mostrarFichaDesdePropiedades(item);
    }

    function mostrarFichaDesdePropiedades(item) {
        currentSelectedItem = item;

        document.getElementById('fichaNombre').innerText = item.nombre || "SIN TITULAR REGISTRADO";
        document.getElementById('fichaIdSistema').innerText = "ID Sistema: #" + (item.idSistema || item.idCodigo || "16300025");
        document.getElementById('fichaCodFijo').innerText = item.codFijo || "-";
        document.getElementById('fichaCodSIG').innerText = item.codSIG || "-";
        document.getElementById('fichaUV').innerText = "UV " + (item.uv || "-");
        document.getElementById('fichaMza').innerText = "Mz " + (item.mza || "-");
        document.getElementById('fichaLote').innerText = "Lote " + (item.lote || "-");
        document.getElementById('fichaLat').innerText = item.latitud ? Number(item.latitud).toFixed(6) : "-";
        document.getElementById('fichaLon').innerText = item.longitud ? Number(item.longitud).toFixed(6) : "-";
        document.getElementById('fichaFecha').innerText = item.fechaEstado || "22/9/2026";

        // Badge de Estado en Ficha con alto contraste WCAG AA
        const badge = document.getElementById('fichaBadgeEstado');
        const desc = obtenerDescEstado(item.estado);
        let badgeBg = '#D1FAE5';
        let badgeColor = '#065F46';
        let badgeBorder = '#A7F3D0';
        if (item.estado === 2) {
            badgeBg = '#FEF3C7';
            badgeColor = '#78350F';
            badgeBorder = '#FDE68A';
        } else if (item.estado === 3) {
            badgeBg = '#FEE2E2';
            badgeColor = '#991B1B';
            badgeBorder = '#FECACA';
        } else if (item.estado > 3) {
            badgeBg = '#E2E8F0';
            badgeColor = '#475569';
            badgeBorder = '#CBD5E1';
        }
        badge.style.backgroundColor = badgeBg;
        badge.style.color = badgeColor;
        badge.style.border = `1px solid ${badgeBorder}`;
        badge.innerHTML = `<i class="bi bi-tag-fill me-1"></i> Estado ${item.estado}: ${desc}`;

        // Botón Ver en Consultas
        const btnConsultas = document.getElementById('btnFichaVerConsultas');
        const param = item.codFijo && item.codFijo !== "-" ? item.codFijo : item.nombre;
        btnConsultas.href = `/Consultas?texto=${encodeURIComponent(param)}`;

        // Mostrar u ocultar botón de modificar estado
        document.getElementById('boxModificarEstadoFicha').style.display = item.codFijo && item.codFijo !== "-" ? 'block' : 'none';

        // Mostrar Panel Ficha Catastral
        document.getElementById('fichaCatastralPanel').style.display = 'block';
    }

    function cerrarFicha() {
        document.getElementById('fichaCatastralPanel').style.display = 'none';
        if (highlightCircleMarker) {
            map.removeLayer(highlightCircleMarker);
            highlightCircleMarker = null;
        }
    }

    function copiarCoordenadasFicha() {
        if (!currentSelectedItem || !currentSelectedItem.latitud || !currentSelectedItem.longitud) return;

        const coords = `${Number(currentSelectedItem.latitud).toFixed(6)}, ${Number(currentSelectedItem.longitud).toFixed(6)}`;
        navigator.clipboard.writeText(coords).then(() => {
            alert(`Coordenadas copiadas al portapapeles:\n${coords}`);
        }).catch(() => {
            prompt("Copie las coordenadas:", coords);
        });
    }

    function abrirModalModificarDesdeFicha() {
        if (!currentSelectedItem) return;

        document.getElementById('mapaModalCodFijo').value = currentSelectedItem.codFijo;
        document.getElementById('mapaModalTxtCodFijo').innerText = currentSelectedItem.codFijo;
        document.getElementById('mapaModalTxtTitular').innerText = currentSelectedItem.nombre;
        document.getElementById('mapaModalSelEstado').value = currentSelectedItem.estado || 1;
        document.getElementById('mapaModalTxtMotivo').value = "";
        document.getElementById('mapaModalAlertError').style.display = "none";

        if (!modalMapaInstance) {
            modalMapaInstance = new bootstrap.Modal(document.getElementById('modalMapaCambioEstado'));
        }
        modalMapaInstance.show();
    }

    function guardarEstadoDesdeMapa() {
        const codFijo = parseInt(document.getElementById('mapaModalCodFijo').value);
        const nuevoEstado = parseInt(document.getElementById('mapaModalSelEstado').value);
        const motivo = document.getElementById('mapaModalTxtMotivo').value.trim();
        const alertError = document.getElementById('mapaModalAlertError');

        if (!codFijo || isNaN(codFijo)) {
            alertError.innerText = "Código fijo inválido.";
            alertError.style.display = "block";
            return;
        }

        const btn = document.getElementById('btnMapaGuardarEstado');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Guardando...';

        fetch('/api/suministros/cambiar-estado', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                codFijo: codFijo,
                nuevoEstado: nuevoEstado,
                motivo: motivo || "Actualización desde Visor Cartográfico"
            })
        })
        .then(res => res.json())
        .then(data => {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-check2-circle"></i> Guardar Estado';

            if (data.exito) {
                if (modalMapaInstance) modalMapaInstance.hide();

                // Actualizar item actual
                if (currentSelectedItem && currentSelectedItem.codFijo === codFijo) {
                    currentSelectedItem.estado = nuevoEstado;
                    mostrarFichaDesdePropiedades(currentSelectedItem);
                }

                // Actualizar en el arreglo local
                const idx = rawCodigosFijos.findIndex(x => x.codFijo === codFijo);
                if (idx !== -1) {
                    rawCodigosFijos[idx].estado = nuevoEstado;
                    renderizarCapaCodigosFijos(rawCodigosFijos);
                    renderizarListaCards(rawCodigosFijos);
                }

                alert(`Estado actualizado correctamente a: ${data.descripcionEstado}`);
            } else {
                alertError.innerText = data.mensaje || "Error al actualizar.";
                alertError.style.display = "block";
            }
        })
        .catch(err => {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-check2-circle"></i> Guardar Estado';
            alertError.innerText = "Error de conexión con el servidor.";
            alertError.style.display = "block";
        });
    }

    function setupSidebarEvents() {
        // Selector de Mapa Base
        document.getElementById('selMapaBase').addEventListener('change', function () {
            const val = this.value;
            if (currentBaseLayer && map.hasLayer(currentBaseLayer)) {
                map.removeLayer(currentBaseLayer);
            }
            if (val === 'topo') currentBaseLayer = baseLayers.topo;
            else if (val === 'esri') currentBaseLayer = baseLayers.esri;
            else currentBaseLayer = baseLayers.osm;

            currentBaseLayer.addTo(map);
        });

        // Toggles de Capas
        document.getElementById('chkManzanas').addEventListener('change', function () {
            if (!layerManzanas) return;
            if (this.checked) map.addLayer(layerManzanas);
            else map.removeLayer(layerManzanas);
        });

        document.getElementById('chkLotes').addEventListener('change', function () {
            if (!layerLotes) return;
            if (this.checked) map.addLayer(layerLotes);
            else map.removeLayer(layerLotes);
        });

        document.getElementById('chkVias').addEventListener('change', function () {
            if (!layerVias) return;
            if (this.checked) map.addLayer(layerVias);
            else map.removeLayer(layerVias);
        });

        document.getElementById('chkCodigosFijos').addEventListener('change', function () {
            if (!layerCodigosFijos) return;
            if (this.checked) map.addLayer(layerCodigosFijos);
            else map.removeLayer(layerCodigosFijos);
        });

        // Búsqueda al presionar Enter en el input de texto
        document.getElementById('txtBusquedaPredio').addEventListener('keyup', function (e) {
            if (e.key === 'Enter') {
                ejecutarFiltroLateral();
            }
        });
    }

    function ejecutarFiltroLateral() {
        const mza = document.getElementById('selFiltroMza').value.trim();
        const lote = document.getElementById('selFiltroLote').value.trim();
        const texto = document.getElementById('txtBusquedaPredio').value.trim().toLowerCase();

        let filtrados = rawCodigosFijos.filter(item => {
            let ok = true;
            if (mza && item.mza !== mza) ok = false;
            if (lote && item.lote !== lote) ok = false;
            if (texto) {
                const matchCod = String(item.codFijo || '').includes(texto);
                const matchNom = String(item.nombre || '').toLowerCase().includes(texto);
                const matchSIG = String(item.codSIG || '').toLowerCase().includes(texto);
                if (!matchCod && !matchNom && !matchSIG) ok = false;
            }
            return ok;
        });

        filtrados.sort((a, b) => (parseInt(a.codFijo) || 999999) - (parseInt(b.codFijo) || 999999));

        renderizarCapaCodigosFijos(filtrados);
        renderizarListaCards(filtrados);

        if (filtrados.length === 1) {
            seleccionarPredioEnMapa(filtrados[0]);
        } else if (filtrados.length > 1 && layerCodigosFijos) {
            const bounds = layerCodigosFijos.getBounds();
            if (bounds.isValid()) {
                map.fitBounds(bounds, { padding: [40, 40], maxZoom: 18 });
            }
        }
    }

    function resetearFiltrosLaterales() {
        document.getElementById('selFiltroMza').value = "";
        document.getElementById('selFiltroLote').value = "";
        document.getElementById('txtBusquedaPredio').value = "";
        renderizarCapaCodigosFijos(rawCodigosFijos);
        renderizarListaCards(rawCodigosFijos);
        cerrarFicha();
        restablecerExtensionGeneral();
    }

    function limpiarListaResultados() {
        resetearFiltrosLaterales();
    }

    function restablecerExtensionGeneral() {
        map.fitBounds(initialBounds);
    }

    function verificarParametrosURL() {
        const urlParams = new URLSearchParams(window.location.search);
        const lat = urlParams.get('lat');
        const lon = urlParams.get('lon') || urlParams.get('lng');
        const codFijo = urlParams.get('codFijo') || urlParams.get('cod');
        const texto = urlParams.get('texto');

        if (texto) {
            document.getElementById('txtBusquedaPredio').value = texto;
        }

        if (lat && lon) {
            const pLat = parseFloat(lat);
            const pLon = parseFloat(lon);
            map.flyTo([pLat, pLon], 18);

            setTimeout(() => {
                // Buscar si coincide con algún código fijo
                const target = rawCodigosFijos.find(c => (codFijo && (c.codFijo == codFijo || c.idCodigo == codFijo)) || (Math.abs(c.latitud - pLat) < 0.0001 && Math.abs(c.longitud - pLon) < 0.0001));
                if (target) {
                    seleccionarPredioEnMapa(target);
                } else {
                    mostrarFichaDesdePropiedades({
                        nombre: "PREDIO SELECCIONADO",
                        idSistema: "GEO-" + Math.round(pLat * 1000),
                        codFijo: codFijo || "-",
                        codSIG: "-",
                        uv: "-",
                        mza: "-",
                        lote: "-",
                        estado: 1,
                        latitud: pLat,
                        longitud: pLon
                    });
                }
            }, 1000);
        }
    }

    function toggleMapSidebarMobile() {
        const sidebar = document.getElementById('mapSidebar');
        const backdrop = document.getElementById('mapSidebarBackdrop');
        if (!sidebar) return;
        const isOpen = sidebar.classList.toggle('sidebar-open');
        if (backdrop) {
            if (isOpen) {
                backdrop.classList.remove('d-none');
            } else {
                backdrop.classList.add('d-none');
            }
        }
    }
</script>
}
