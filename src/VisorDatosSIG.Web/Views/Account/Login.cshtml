@model VisorDatosSIG.Application.DTOs.LoginDto
@{
    ViewData["Title"] = "Acceso Seguro";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VisorDatosSIG</title>
    
    <!-- Google Fonts: Space Grotesk + Plus Jakarta Sans + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5.3 & Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        :root {
            --bg-page: #F5F3EC;
            --bg-card: #FFFFFF;
            --border-subtle: #DFDBD1;
            --border-focus: #C89D3C;
            --gold-primary: #B88B2A;
            --gold-gradient: linear-gradient(135deg, #C89D3C 0%, #A97E25 100%);
            --text-dark: #242722;
            --text-muted: #6F756C;
            --olive-accent: #44644B;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--bg-page);
            color: var(--text-dark);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow-x: hidden;
            padding: 1.5rem 1rem;
        }

        /* Cartographic Grid & Topo Background (Light Palette) */
        .carto-grid {
            position: fixed;
            inset: 0;
            z-index: 1;
            pointer-events: none;
            background-size: 50px 50px;
            background-image: 
                linear-gradient(to right, rgba(0, 0, 0, 0.035) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(0, 0, 0, 0.035) 1px, transparent 1px);
        }

        .topo-svg {
            position: fixed;
            inset: 0;
            z-index: 0;
            width: 100%;
            height: 100%;
            opacity: 0.35;
            pointer-events: none;
        }

        /* Login Card */
        .login-card {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 440px;
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            border-radius: 12px;
            box-shadow: 
                0 20px 45px rgba(0, 0, 0, 0.07),
                0 2px 10px rgba(0, 0, 0, 0.03);
            overflow: hidden;
            animation: cardAppear 0.5s ease-out forwards;
        }

        @@keyframes cardAppear {
            0% { opacity: 0; transform: translateY(16px); }
            100% { opacity: 1; transform: translateY(0); }
        }

        /* Top Accent Bar */
        .card-accent-bar {
            height: 4px;
            background: linear-gradient(90deg, #44644B 0%, #C89D3C 50%, #44644B 100%);
        }

        /* Header */
        .card-header-custom {
            padding: 2rem 2rem 1.2rem;
            text-align: center;
            background: #FAF9F6;
            border-bottom: 1px solid #EFECE4;
        }

        .sig-emblem {
            width: 52px;
            height: 52px;
            margin: 0 auto 0.9rem;
            background: #F4F2EC;
            border: 1.5px solid var(--gold-primary);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            transform: rotate(45deg);
        }

        .sig-emblem i {
            transform: rotate(-45deg);
            font-size: 1.45rem;
            color: var(--gold-primary);
        }

        .brand-title {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 0.2rem;
            letter-spacing: 0.3px;
        }

        .brand-title span {
            color: var(--gold-primary);
        }

        .brand-subtitle {
            font-size: 0.74rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-muted);
            font-weight: 600;
        }

        .coord-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-top: 0.65rem;
            padding: 0.22rem 0.65rem;
            background: #ECE8DE;
            border: 1px solid #DBD6C9;
            border-radius: 16px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.7rem;
            color: #4A5046;
        }

        .coord-badge .pulse-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background-color: #388E3C;
        }

        /* Body */
        .card-body-custom {
            padding: 1.8rem 2rem;
        }

        .form-label-custom {
            font-size: 0.76rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            color: #494E45;
            margin-bottom: 0.35rem;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .input-group-custom {
            display: flex;
            align-items: center;
            background: #FAF9F6;
            border: 1px solid #D5D0C3;
            border-radius: 6px;
            transition: all 0.2s ease;
        }

        .input-group-custom:focus-within {
            border-color: var(--border-focus);
            box-shadow: 0 0 0 3px rgba(200, 157, 60, 0.2);
            background: #FFFFFF;
        }

        .input-icon {
            padding: 0 0.8rem;
            color: var(--gold-primary);
            font-size: 0.95rem;
        }

        .form-control-custom {
            width: 100%;
            background: transparent;
            border: none;
            color: var(--text-dark);
            padding: 0.65rem 0.8rem 0.65rem 0;
            font-size: 0.9rem;
            font-family: 'Plus Jakarta Sans', sans-serif;
            outline: none;
        }

        .form-control-custom::placeholder {
            color: #A0A59D;
            font-size: 0.84rem;
        }

        .btn-toggle-pwd {
            background: none;
            border: none;
            color: #8C9188;
            padding: 0 0.8rem;
            font-size: 0.95rem;
            cursor: pointer;
        }

        .btn-toggle-pwd:hover {
            color: var(--text-dark);
        }

        /* Submit Button */
        .btn-submit {
            width: 100%;
            padding: 0.75rem 1.2rem;
            margin-top: 1.2rem;
            background: var(--gold-gradient);
            color: #FFFFFF;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            font-size: 0.88rem;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            box-shadow: 0 3px 10px rgba(184, 139, 42, 0.25);
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
        }

        .btn-submit:hover {
            opacity: 0.94;
            transform: translateY(-1px);
            box-shadow: 0 5px 15px rgba(184, 139, 42, 0.35);
        }

        /* Quick Roles */
        .roles-section {
            margin-top: 1.5rem;
            padding-top: 1.1rem;
            border-top: 1px solid #ECE9E1;
        }

        .roles-label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            color: var(--text-muted);
            text-align: center;
            margin-bottom: 0.6rem;
            font-weight: 600;
        }

        .roles-pills {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 6px;
        }

        .role-pill {
            background: #FAF9F6;
            border: 1px solid #E0DCD2;
            border-radius: 6px;
            padding: 0.45rem 0.25rem;
            color: #494E45;
            font-size: 0.74rem;
            font-weight: 600;
            text-align: center;
            cursor: pointer;
            transition: all 0.15s ease;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2px;
        }

        .role-pill i {
            font-size: 0.95rem;
            color: var(--gold-primary);
        }

        .role-pill:hover {
            background: #ECE8DE;
            border-color: var(--border-focus);
            color: var(--text-dark);
        }

        /* Alert */
        .alert-error-custom {
            background: #FDF3F2;
            border: 1px solid #F0C4C0;
            border-radius: 6px;
            padding: 0.6rem 0.8rem;
            margin-bottom: 1rem;
            color: #9C2E24;
            font-size: 0.8rem;
            display: flex;
            align-items: center;
            gap: 7px;
        }

        /* Footer */
        .card-footer-custom {
            padding: 0.75rem 1.2rem;
            background: #FAF9F6;
            border-top: 1px solid #EFECE4;
            font-size: 0.7rem;
            color: #798075;
            text-align: center;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            font-family: 'JetBrains Mono', monospace;
        }
    </style>
</head>
<body>

    <!-- Background Grid -->
    <div class="carto-grid"></div>

    <!-- Topographic Contour Lines SVG (Light Tones) -->
    <svg class="topo-svg" viewBox="0 0 1000 1000" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M-200,200 C150,100 350,300 700,150 C950,50 1100,250 1300,150" fill="none" stroke="#C89D3C" stroke-width="1.2" stroke-dasharray="6,4"/>
        <path d="M-200,340 C100,240 400,440 750,290 C1000,190 1150,370 1300,290" fill="none" stroke="#C89D3C" stroke-width="0.8"/>
        <path d="M-200,480 C200,380 450,580 820,430 C1050,330 1200,530 1300,430" fill="none" stroke="#44644B" stroke-width="1.2" stroke-dasharray="4,4"/>
        <path d="M-200,620 C150,520 500,720 880,560 C1100,460 1250,660 1300,570" fill="none" stroke="#C89D3C" stroke-width="0.8"/>
        <path d="M-200,760 C250,640 550,840 920,690 C1150,590 1220,790 1300,720" fill="none" stroke="#44644B" stroke-width="1.2"/>
    </svg>

    <!-- Card -->
    <div class="login-card">
        <div class="card-accent-bar"></div>

        <div class="card-header-custom">
            <div class="sig-emblem">
                <i class="bi bi-compass"></i>
            </div>
            <h1 class="brand-title">VisorDatos<span>SIG</span></h1>
            <p class="brand-subtitle">Catastro y Territorio Municipal</p>
            <div class="coord-badge">
                <span class="pulse-dot"></span>
                <span>16°22'28"S  60°57'35"W  •  SRID 4326</span>
            </div>
        </div>

        <div class="card-body-custom">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert-error-custom">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>Usuario o contraseña incorrectos.</span>
                </div>
            }

            <form asp-action="Login" method="post" id="formLogin">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <div class="mb-3">
                    <label asp-for="Usuario" class="form-label-custom">
                        <i class="bi bi-person"></i>
                        Usuario
                    </label>
                    <div class="input-group-custom">
                        <span class="input-icon"><i class="bi bi-person-badge"></i></span>
                        <input asp-for="Usuario" id="inputUsuario" class="form-control-custom" placeholder="Ej. consultor, operador o admin" autofocus required autocomplete="username" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label-custom">
                        <i class="bi bi-key"></i>
                        Contraseña
                    </label>
                    <div class="input-group-custom">
                        <span class="input-icon"><i class="bi bi-shield-lock"></i></span>
                        <input asp-for="Password" id="inputPassword" type="password" class="form-control-custom" placeholder="••••••••••••" required autocomplete="current-password" />
                        <button type="button" class="btn-toggle-pwd" id="btnTogglePassword" title="Mostrar/Ocultar" tabindex="-1">
                            <i class="bi bi-eye" id="iconEye"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn-submit" id="btnIngresar">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>Ingresar</span>
                </button>
            </form>

            <div class="roles-section">
                <div class="roles-label">Carga Rápida de Perfiles</div>
                <div class="roles-pills">
                    <div class="role-pill" onclick="cargarCredenciales('consultor', 'Admin123!')" title="Consultor (Solo Lectura, Consultas, CSV)">
                        <i class="bi bi-search"></i>
                        <span>Consultor</span>
                    </div>
                    <div class="role-pill" onclick="cargarCredenciales('operador', 'Admin123!')" title="Operador (Actualización de Suministros)">
                        <i class="bi bi-pencil-square"></i>
                        <span>Operador</span>
                    </div>
                    <div class="role-pill" onclick="cargarCredenciales('admin', 'Admin123!')" title="Administrador (Total)">
                        <i class="bi bi-shield-check"></i>
                        <span>Admin</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-footer-custom">
            <i class="bi bi-shield-lock" style="color: var(--gold-primary);"></i>
            <span>SAN IGNACIO DE VELASCO • GOBIERNO MUNICIPAL</span>
        </div>
    </div>

    <script>
        function cargarCredenciales(usr, pwd) {
            document.getElementById('inputUsuario').value = usr;
            document.getElementById('inputPassword').value = pwd;
        }

        document.getElementById('btnTogglePassword').addEventListener('click', function () {
            const inPass = document.getElementById('inputPassword');
            const icon = document.getElementById('iconEye');
            if (inPass.type === 'password') {
                inPass.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                inPass.type = 'password';
                icon.className = 'bi bi-eye';
            }
        });

        document.getElementById('formLogin').addEventListener('submit', function () {
            const btn = document.getElementById('btnIngresar');
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Ingresando...';
            btn.style.opacity = '0.85';
            btn.style.pointerEvents = 'none';
        });
    </script>
</body>
</html>
