@model VisorDatosSIG.Application.DTOs.LoginDto
@{
    ViewData["Title"] = "Acceso Seguro al Sistema SIG";
    Layout = null; // Autocontenido con estética inmersiva personalizada
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VisorDatosSIG</title>
    
    <!-- Google Fonts: Space Grotesk + Plus Jakarta Sans + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5.3 & Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        :root {
            --bg-deep: #0D110F;
            --bg-surface: #141A16;
            --bg-card: rgba(20, 26, 22, 0.88);
            --gold-primary: #C89D3C;
            --gold-hover: #DFB453;
            --gold-glow: rgba(200, 157, 60, 0.25);
            --emerald-accent: #3E6349;
            --text-main: #EDEDE8;
            --text-muted: #959C94;
            --border-subtle: rgba(200, 157, 60, 0.22);
            --border-hover: rgba(200, 157, 60, 0.55);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--bg-deep);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow-x: hidden;
            padding: 1.5rem 1rem;
        }

        /* Topographic Contour Lines Animated SVG Background */
        .carto-bg {
            position: fixed;
            inset: 0;
            z-index: 0;
            opacity: 0.18;
            pointer-events: none;
            background-image: radial-gradient(circle at 50% 30%, rgba(62, 99, 73, 0.4) 0%, transparent 70%),
                              radial-gradient(circle at 80% 80%, rgba(200, 157, 60, 0.2) 0%, transparent 60%);
            background-repeat: no-repeat;
        }

        .carto-grid {
            position: fixed;
            inset: 0;
            z-index: 1;
            pointer-events: none;
            background-size: 60px 60px;
            background-image: 
                linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
        }

        /* Cartographic SVG Topo Pattern */
        .topo-svg {
            position: fixed;
            inset: 0;
            z-index: 0;
            width: 100%;
            height: 100%;
            opacity: 0.12;
            pointer-events: none;
        }

        /* Main Card */
        .login-card {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 460px;
            background: var(--bg-card);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid var(--border-subtle);
            border-radius: 16px;
            box-shadow: 
                0 30px 60px -15px rgba(0, 0, 0, 0.75),
                0 0 40px -10px var(--gold-glow),
                inset 0 1px 0 rgba(255, 255, 255, 0.08);
            overflow: hidden;
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
            animation: cardAppear 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .login-card:hover {
            border-color: var(--border-hover);
            box-shadow: 
                0 35px 70px -15px rgba(0, 0, 0, 0.85),
                0 0 50px -5px rgba(200, 157, 60, 0.3),
                inset 0 1px 0 rgba(255, 255, 255, 0.15);
        }

        @@keyframes cardAppear {
            0% {
                opacity: 0;
                transform: translateY(24px) scale(0.97);
            }
            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        /* Top Accent Banner */
        .card-accent-bar {
            height: 4px;
            background: linear-gradient(90deg, #3E6349 0%, #C89D3C 50%, #E4C06A 75%, #3E6349 100%);
            background-size: 200% auto;
            animation: shimmerBar 4s linear infinite;
        }

        @@keyframes shimmerBar {
            0% { background-position: 0% center; }
            100% { background-position: 200% center; }
        }

        /* Card Header */
        .card-header-custom {
            padding: 2.2rem 2.2rem 1.4rem;
            text-align: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            position: relative;
        }

        .sig-emblem {
            width: 58px;
            height: 58px;
            margin: 0 auto 1.2rem;
            background: linear-gradient(135deg, rgba(200, 157, 60, 0.2) 0%, rgba(62, 99, 73, 0.25) 100%);
            border: 1.5px solid var(--gold-primary);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 20px rgba(200, 157, 60, 0.25);
            position: relative;
            transform: rotate(45deg);
            transition: transform 0.4s ease, box-shadow 0.4s ease;
        }

        .sig-emblem i {
            transform: rotate(-45deg);
            font-size: 1.6rem;
            color: var(--gold-primary);
        }

        .login-card:hover .sig-emblem {
            transform: rotate(45deg) scale(1.05);
            box-shadow: 0 0 30px rgba(200, 157, 60, 0.4);
        }

        .brand-title {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.55rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            color: #FFFFFF;
            margin-bottom: 0.3rem;
        }

        .brand-title span {
            color: var(--gold-primary);
        }

        .brand-subtitle {
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: var(--text-muted);
            font-weight: 500;
        }

        .coord-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-top: 0.8rem;
            padding: 0.28rem 0.75rem;
            background: rgba(0, 0, 0, 0.35);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.72rem;
            color: #C5CCC3;
        }

        .coord-badge .pulse-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background-color: #4CAF50;
            box-shadow: 0 0 8px #4CAF50;
            animation: pulseDot 2s infinite;
        }

        @@keyframes pulseDot {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(0.8); }
        }

        /* Card Body */
        .card-body-custom {
            padding: 1.8rem 2.2rem 2.2rem;
        }

        .form-label-custom {
            font-size: 0.78rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: #B5BAB2;
            margin-bottom: 0.45rem;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .input-group-custom {
            position: relative;
            display: flex;
            align-items: center;
            background: rgba(12, 16, 14, 0.75);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 8px;
            transition: all 0.25s ease;
        }

        .input-group-custom:focus-within {
            border-color: var(--gold-primary);
            box-shadow: 0 0 0 3px var(--gold-glow);
            background: rgba(15, 20, 17, 0.95);
        }

        .input-icon {
            padding: 0 0.9rem;
            color: var(--gold-primary);
            font-size: 1.05rem;
        }

        .form-control-custom {
            width: 100%;
            background: transparent;
            border: none;
            color: #FFFFFF;
            padding: 0.72rem 0.9rem 0.72rem 0;
            font-size: 0.92rem;
            font-family: 'Plus Jakarta Sans', sans-serif;
            outline: none;
        }

        .form-control-custom::placeholder {
            color: #5D635C;
            font-size: 0.86rem;
        }

        .btn-toggle-pwd {
            background: none;
            border: none;
            color: #798076;
            padding: 0 0.9rem;
            font-size: 1rem;
            cursor: pointer;
            transition: color 0.2s ease;
        }

        .btn-toggle-pwd:hover {
            color: var(--text-main);
        }

        /* Submit Button */
        .btn-submit {
            position: relative;
            overflow: hidden;
            width: 100%;
            padding: 0.85rem 1.5rem;
            margin-top: 1.4rem;
            background: linear-gradient(135deg, #C89D3C 0%, #A9802A 100%);
            color: #111413;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            font-size: 0.92rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(200, 157, 60, 0.35);
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-submit:hover {
            background: linear-gradient(135deg, #DFB453 0%, #BA8F33 100%);
            box-shadow: 0 6px 25px rgba(200, 157, 60, 0.55);
            transform: translateY(-1px);
            color: #0A0D0B;
        }

        .btn-submit:active {
            transform: translateY(1px);
            box-shadow: 0 2px 10px rgba(200, 157, 60, 0.3);
        }

        /* Quick Roles Selector */
        .roles-section {
            margin-top: 1.8rem;
            padding-top: 1.4rem;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }

        .roles-label {
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: var(--text-muted);
            text-align: center;
            margin-bottom: 0.8rem;
            font-weight: 600;
        }

        .roles-pills {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 6px;
        }

        .role-pill {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 6px;
            padding: 0.45rem 0.3rem;
            color: #BAC2B8;
            font-size: 0.74rem;
            font-weight: 500;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2px;
            user-select: none;
        }

        .role-pill i {
            font-size: 0.9rem;
            color: var(--gold-primary);
        }

        .role-pill:hover {
            background: rgba(200, 157, 60, 0.12);
            border-color: rgba(200, 157, 60, 0.35);
            color: #FFFFFF;
            transform: translateY(-1px);
        }

        /* Alert */
        .alert-error-custom {
            background: rgba(184, 74, 57, 0.15);
            border: 1px solid rgba(184, 74, 57, 0.4);
            border-radius: 8px;
            padding: 0.75rem 1rem;
            margin-bottom: 1.2rem;
            color: #FFA596;
            font-size: 0.82rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* Footer */
        .card-footer-custom {
            padding: 0.9rem 1.5rem;
            background: rgba(10, 13, 11, 0.6);
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            font-size: 0.72rem;
            color: #6C726A;
            text-align: center;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            font-family: 'JetBrains Mono', monospace;
        }
    </style>
</head>
<body>

    <!-- Atmospheric Layers -->
    <div class="carto-bg"></div>
    <div class="carto-grid"></div>

    <!-- Topographic Contour Lines Overlay (Pure SVG) -->
    <svg class="topo-svg" viewBox="0 0 1000 1000" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M-200,200 C150,100 350,300 700,150 C950,50 1100,250 1300,150" fill="none" stroke="#C89D3C" stroke-width="1.2" stroke-dasharray="6,4"/>
        <path d="M-200,320 C100,220 400,420 750,270 C1000,170 1150,350 1300,270" fill="none" stroke="#C89D3C" stroke-width="0.8"/>
        <path d="M-200,450 C200,350 450,550 820,400 C1050,300 1200,500 1300,400" fill="none" stroke="#3E6349" stroke-width="1.2" stroke-dasharray="4,4"/>
        <path d="M-200,580 C150,480 500,680 880,520 C1100,420 1250,620 1300,530" fill="none" stroke="#C89D3C" stroke-width="0.8"/>
        <path d="M-200,720 C250,600 550,800 920,650 C1150,550 1220,750 1300,680" fill="none" stroke="#3E6349" stroke-width="1.2"/>
        <path d="M-200,850 C200,750 600,920 980,780 C1180,680 1280,880 1300,820" fill="none" stroke="#C89D3C" stroke-width="0.8" stroke-dasharray="6,4"/>
    </svg>

    <!-- Main Login Container -->
    <div class="login-card">
        <!-- Top Shimmer Bar -->
        <div class="card-accent-bar"></div>

        <!-- Header -->
        <div class="card-header-custom">
            <div class="sig-emblem">
                <i class="bi bi-compass"></i>
            </div>
            <h1 class="brand-title">VisorDatos<span>SIG</span></h1>
            <p class="brand-subtitle">Catastro y Territorio Municipal</p>
            <div class="coord-badge">
                <span class="pulse-dot"></span>
                <span>16°22'28"S  60°57'35"W  •  SRID 4326</span>
            </div>
        </div>

        <!-- Body Form -->
        <div class="card-body-custom">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert-error-custom">
                    <i class="bi bi-shield-slash fs-5"></i>
                    <div>
                        <strong>Credenciales inválidas</strong>
                        <div style="font-size: 0.76rem; opacity: 0.85;">Verifique el usuario y contraseña e intente nuevamente.</div>
                    </div>
                </div>
            }

            <form asp-action="Login" method="post" id="formLogin">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <!-- Usuario -->
                <div class="mb-3">
                    <label asp-for="Usuario" class="form-label-custom">
                        <i class="bi bi-person"></i>
                        Usuario del Sistema
                    </label>
                    <div class="input-group-custom">
                        <span class="input-icon"><i class="bi bi-person-badge"></i></span>
                        <input asp-for="Usuario" id="inputUsuario" class="form-control-custom" placeholder="Ej. consultor, operador o admin" autofocus required autocomplete="username" />
                    </div>
                </div>

                <!-- Contraseña -->
                <div class="mb-3">
                    <label asp-for="Password" class="form-label-custom">
                        <i class="bi bi-key"></i>
                        Contraseña
                    </label>
                    <div class="input-group-custom">
                        <span class="input-icon"><i class="bi bi-shield-lock"></i></span>
                        <input asp-for="Password" id="inputPassword" type="password" class="form-control-custom" placeholder="••••••••••••" required autocomplete="current-password" />
                        <button type="button" class="btn-toggle-pwd" id="btnTogglePassword" title="Mostrar/Ocultar contraseña" tabindex="-1">
                            <i class="bi bi-eye" id="iconEye"></i>
                        </button>
                    </div>
                </div>

                <!-- Botón de Envío -->
                <button type="submit" class="btn-submit" id="btnIngresar">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>Ingresar al Sistema</span>
                </button>
            </form>

            <!-- Acceso Rápido por Perfiles (Demostración y Auditoría) -->
            <div class="roles-section">
                <div class="roles-label">
                    <i class="bi bi-lightning-charge me-1" style="color: var(--gold-primary);"></i>
                    Carga Rápida por Perfil Autorizado
                </div>
                <div class="roles-pills">
                    <div class="role-pill" onclick="cargarCredenciales('consultor', 'Admin123!')" title="Acceso de Consultor (Mapas, Consultas, Reportes, CSV)">
                        <i class="bi bi-search"></i>
                        <span>Consultor</span>
                        <span style="font-size: 0.65rem; color: #8F968D;">Solo Lectura</span>
                    </div>
                    <div class="role-pill" onclick="cargarCredenciales('operador', 'Admin123!')" title="Acceso de Operador (Edición de Estado de Suministros)">
                        <i class="bi bi-pencil-square"></i>
                        <span>Operador</span>
                        <span style="font-size: 0.65rem; color: #8F968D;">Edición</span>
                    </div>
                    <div class="role-pill" onclick="cargarCredenciales('admin', 'Admin123!')" title="Acceso de Administrador (Total: Usuarios, Bitácora, Config)">
                        <i class="bi bi-shield-check"></i>
                        <span>Administrador</span>
                        <span style="font-size: 0.65rem; color: #8F968D;">Total</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="card-footer-custom">
            <i class="bi bi-lock-fill" style="color: var(--gold-primary);"></i>
            <span>CONEXIÓN SEGURA TLS • SAN IGNACIO DE VELASCO</span>
        </div>
    </div>

    <!-- Micro-interacción: Llenado de credenciales y toggle de contraseña -->
    <script>
        function cargarCredenciales(usr, pwd) {
            const inUser = document.getElementById('inputUsuario');
            const inPass = document.getElementById('inputPassword');
            inUser.value = usr;
            inPass.value = pwd;

            // Micro-feedback visual
            inUser.style.transform = 'scale(1.02)';
            inPass.style.transform = 'scale(1.02)';
            setTimeout(() => {
                inUser.style.transform = 'none';
                inPass.style.transform = 'none';
            }, 180);
        }

        document.getElementById('btnTogglePassword').addEventListener('click', function () {
            const inPass = document.getElementById('inputPassword');
            const icon = document.getElementById('iconEye');
            if (inPass.type === 'password') {
                inPass.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                inPass.type = 'password';
                icon.className = 'bi bi-eye';
            }
        });

        document.getElementById('formLogin').addEventListener('submit', function () {
            const btn = document.getElementById('btnIngresar');
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Validando...';
            btn.style.opacity = '0.85';
            btn.style.pointerEvents = 'none';
        });
    </script>
</body>
</html>
